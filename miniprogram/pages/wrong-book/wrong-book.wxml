<page-meta page-style="{{detail ? 'overflow: hidden;' : ''}}"/><view class="page"><view wx:if="{{error}}" class="error-tip">{{error}}</view><view class="page-heading"><view class="page-eyebrow">错误原因 → 掌握计划 → 延迟复测</view><view class="title">错题本</view><view class="page-subtitle">共 {{total}} 道，仅显示当前孩子的真实错题</view></view><view wx:if="{{loading}}" class="loading-block">正在读取错题...</view><view wx:elif="{{items.length}}" class="wrong-list"><view wx:for="{{items}}" wx:key="id" class="wrong-card" data-id="{{item.id}}" bindtap="openDetail"><view class="wrong-top"><view class="wrong-type">{{item.typeName}}</view><view class="pill {{item.status==='needs_review'?'pill-warn':''}}">{{item.statusText}}</view></view><view class="wrong-title">{{item.title}}</view><view class="wrong-reason"><text>错误原因</text>{{item.reasonText}}</view><view class="wrong-foot"><text>{{item.dateText}}</text><text>查看订正计划 ›</text></view></view></view><view wx:else class="empty">当前没有错题。WorkBuddy 明确保存后会出现在这里</view><view wx:if="{{items.length}}" class="list-footer">{{loadingMore?'正在加载更多…':hasMore?'上拉加载更多':'已显示全部'}}</view><button class="btn btn-outline manage-button" bindtap="goManager">进入完整错题管理</button><view wx:if="{{detail}}" class="modal-mask" catchtap="closeDetail"><view class="modal" catchtap="noop"><view class="modal-header"><view><view class="page-eyebrow">{{detail.typeName}}</view><view class="modal-title">错题详情</view></view><view class="modal-close" bindtap="closeDetail">×</view></view><view class="paper-block"><view class="detail-label">题目</view><text class="paper-text">{{detail.title}}</text></view><view class="paper-block section-block"><view class="detail-label">错误原因</view><text class="paper-text">{{detail.reasonText}}</text></view><view class="paper-block section-block"><view class="detail-label">订正方法</view><text class="paper-text">{{detail.correctionMethod || '尚未记录订正方法'}}</text></view><view class="paper-block section-block"><view class="detail-label">关键学习点</view><text class="paper-text">{{detail.keyLearningPoint || '尚未记录关键学习点'}}</text></view></view></view></view>
