.wrong-list{display:grid;gap:16rpx}.wrong-card{padding:24rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel);box-shadow:var(--shadow-soft)}.wrong-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrong-type{color:var(--teal);font-size:22rpx;font-weight:800}.wrong-title{margin-top:14rpx;display:-webkit-box;overflow:hidden;font-size:29rpx;font-weight:800;line-height:1.6;-webkit-line-clamp:3;-webkit-box-orient:vertical}.wrong-reason{margin-top:16rpx;padding:14rpx 16rpx;border-radius:14rpx;background:#fff7e5;color:var(--ink-soft);font-size:23rpx;line-height:1.55}.wrong-reason text{margin-right:12rpx;color:#9a651c;font-weight:800}.wrong-foot{display:flex;justify-content:space-between;margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid var(--line-soft);color:var(--muted);font-size:22rpx}.wrong-foot text:last-child{color:var(--teal);font-weight:800}.manage-button{margin-top:20rpx}.section-block{margin-top:16rpx}.detail-label{margin-bottom:10rpx;color:var(--teal);font-size:23rpx;font-weight:800}.list-footer{padding:24rpx;text-align:center;color:var(--muted);font-size:22rpx}
