.child-picker {
  display: block;
  margin-bottom: 18rpx;
  border: 1rpx solid #d6e5e0;
  border-radius: 24rpx;
  background: #e4f3ef;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.06);
}

.child-picker-inner { min-height: 112rpx; display: flex; align-items: center; padding: 0 22rpx; }

.picker-avatar {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.picker-content { flex: 1; min-width: 0; margin-left: 16rpx; }
.picker-label { color: #50736f; font-size: 21rpx; }
.picker-value { overflow: hidden; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.picker-arrow { color: #0f766e; font-size: 34rpx; }
.growth-tabs { margin-bottom: 24rpx; }

.timeline-item { position: relative; display: flex; }
.timeline-rail { width: 34rpx; flex-shrink: 0; display: flex; justify-content: center; }
.timeline-rail::after { content: ""; position: absolute; top: 20rpx; bottom: -18rpx; width: 2rpx; background: #d8cdb8; }
.timeline-item:last-child .timeline-rail::after { display: none; }
.timeline-dot { position: relative; z-index: 1; width: 16rpx; height: 16rpx; margin-top: 28rpx; border: 5rpx solid #d7ece7; border-radius: 50%; background: #0f766e; }

.timeline-card {
  flex: 1;
  min-width: 0;
  margin-bottom: 18rpx;
  padding: 28rpx 22rpx 22rpx;
}

.timeline-date { color: #728186; font-size: 21rpx; }
.timeline-title-row { margin-top: 6rpx; align-items: flex-start; }
.record-title { flex: 1; min-width: 0; padding-right: 14rpx; font-size: 29rpx; font-weight: 800; }

.record-preview {
  margin-top: 12rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #52636a;
  font-size: 25rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.record-footer { display: flex; justify-content: space-between; margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid #eee5d3; color: #728186; font-size: 22rpx; }
.read-more { color: #0f766e; font-weight: 700; }

.report-card {
  margin-bottom: 18rpx;
  padding: 30rpx 24rpx 24rpx;
}
.report-card::before { width: 120rpx; background: #f3c969; }

.report-head { display: flex; align-items: center; justify-content: space-between; }
.report-badge { color: #8a6314; font-size: 22rpx; font-weight: 700; }
.report-date { color: #728186; font-size: 21rpx; }
.report-title { margin-top: 12rpx; font-size: 32rpx; font-weight: 800; }
.report-preview { -webkit-line-clamp: 4; }
.report-link { margin-top: 18rpx; text-align: right; font-size: 24rpx; }

.trajectory-overview { overflow: hidden; margin-bottom: 26rpx; }
.trajectory-overview::before { background: #0f766e; }
.trajectory-intro { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding: 30rpx 24rpx 22rpx; border-bottom: 1rpx solid #e8ddc5; background: #fffaf1; }
.trajectory-title { font-size: 30rpx; font-weight: 800; }
.trajectory-intro .muted { margin-top: 3rpx; font-size: 22rpx; }
.trajectory-update { flex-shrink: 0; padding-top: 4rpx; color: #728186; font-size: 20rpx; }
.trajectory-stats { display: grid; grid-template-columns: repeat(3, 1fr); padding: 22rpx 10rpx 24rpx; }
.trajectory-stat { position: relative; text-align: center; }
.trajectory-stat + .trajectory-stat::before { position: absolute; top: 8rpx; bottom: 8rpx; left: 0; width: 1rpx; background: #eee5d3; content: ""; }
.trajectory-stat-value { color: #20343a; font-size: 36rpx; font-weight: 800; line-height: 1.2; }
.trajectory-stat-label { margin-top: 6rpx; color: #728186; font-size: 21rpx; }
.attention-value { color: #c65a3d; }
.positive-value { color: #0f766e; }

.growth-event-list { padding-top: 2rpx; }
.growth-event { position: relative; display: flex; }
.growth-event-rail { position: relative; width: 68rpx; flex-shrink: 0; display: flex; justify-content: center; }
.growth-event-rail::after { position: absolute; top: 52rpx; bottom: -22rpx; width: 2rpx; background: #d8cdb8; content: ""; }
.growth-event:last-child .growth-event-rail::after { display: none; }
.growth-event-icon { position: relative; z-index: 1; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border: 6rpx solid #f7f1df; border-radius: 50%; background: #e7efed; color: #50656a; font-size: 20rpx; font-weight: 800; }
.growth-event-icon.tone-positive { background: #d9efe8; color: #0f766e; }
.growth-event-icon.tone-attention { background: #fde1d8; color: #b84c32; }
.growth-event-card { flex: 1; min-width: 0; margin-bottom: 20rpx; padding: 24rpx; }
.growth-event-card::before { width: 88rpx; background: #f3c969; }
.growth-event-meta { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.growth-event-category { color: #0f766e; font-size: 21rpx; font-weight: 700; }
.growth-date { color: #728186; font-size: 21rpx; }
.growth-event-title { margin-top: 9rpx; color: #20343a; font-size: 29rpx; font-weight: 800; line-height: 1.45; }
.growth-event-summary { margin-top: 10rpx; color: #53656b; font-size: 24rpx; line-height: 1.65; }
.growth-event-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 13rpx; border-top: 1rpx solid #eee5d3; font-size: 22rpx; }
.event-status { color: #657579; font-weight: 700; }
.tone-text-positive { color: #0f766e; }
.tone-text-attention { color: #bd5037; }
.event-score { color: #20343a; font-weight: 800; }
.growth-empty { padding: 46rpx 36rpx; }
.empty-title { color: #31454a; font-size: 28rpx; font-weight: 800; }
.empty-copy { margin-top: 10rpx; color: #7b898b; font-size: 23rpx; line-height: 1.7; }

.detail-kicker { color: #0f766e; font-size: 22rpx; font-weight: 700; }
.detail-meta { margin: -10rpx 0 22rpx; color: #728186; font-size: 23rpx; }
.detail-score-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #e4f3ef, #fffdf7);
  border: 1rpx solid #cce6df;
}
.detail-score-label { color: #50736f; font-size: 24rpx; }
.detail-score { color: #0f766e; font-size: 42rpx; font-weight: 800; }
.detail-score text { font-size: 22rpx; }
.article-lead {
  padding: 24rpx;
  border-radius: 20rpx;
  border-left: 8rpx solid #f3c969;
  background: #fff4cf;
  color: #5f553c;
  font-size: 27rpx;
  line-height: 1.75;
}
.article-section { margin-top: 28rpx; }
.article-section.paper-block { margin-top: 20rpx; }
.note-block { background: #fffaf2; }
.report-body-block { background: #ffffff; }
.detail-label { margin-bottom: 10rpx; color: #0f766e; font-size: 24rpx; font-weight: 800; }
.detail-text { display: block; color: #34474d; font-size: 28rpx; line-height: 1.85; white-space: pre-wrap; word-break: break-all; }

.list-footer {
  padding: 28rpx 0 8rpx;
  color: #8b9899;
  font-size: 23rpx;
  text-align: center;
}
