.picker-panel {
  margin-bottom: 24rpx;
}

.picker-label {
  font-size: 24rpx;
  color: #7a8a90;
  margin-bottom: 10rpx;
}

.picker-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #23353b;
}

.record-title {
  font-size: 30rpx;
  font-weight: 700;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.record-preview {
  margin-top: 14rpx;
  color: #6d5a35;
  font-size: 26rpx;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.growth-progress {
  margin-top: 18rpx;
}

.detail-meta {
  color: #7a8a90;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.detail-label {
  color: #7a8a90;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.detail-text {
  display: block;
  white-space: pre-wrap;
  word-break: break-all;
  font-size: 28rpx;
  line-height: 1.8;
}

.detail-block {
  margin-bottom: 16rpx;
}

.error-tip {
  background: #ffeae4;
  color: #c9503a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
  font-size: 26rpx;
}
