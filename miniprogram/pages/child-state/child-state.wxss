.state-summary-card{display:flex;align-items:center;min-height:250rpx;padding:24rpx;border-radius:28rpx;background:linear-gradient(135deg,#dff1eb,#fff8de);box-shadow:var(--shadow)}.state-summary-card image{width:180rpx;height:220rpx;flex-shrink:0}.state-summary-copy{min-width:0;flex:1}.state-summary-title{margin-top:4rpx;font-size:35rpx;font-weight:900;line-height:1.25}.state-summary-copy .tag-group{margin-top:14rpx}.report-section{display:flex;gap:18rpx;margin-top:18rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.report-section.action{background:var(--teal-soft);border-color:#c9e2dc}.report-number{width:46rpx;color:var(--gold);font-size:24rpx;font-weight:900}.report-main{min-width:0;flex:1}.report-label{color:var(--teal);font-size:22rpx;font-weight:800}.report-text{margin-top:8rpx;color:var(--ink-soft);font-size:27rpx;line-height:1.72}.relationship-card{margin-top:22rpx;padding:24rpx;border-radius:22rpx;background:#fffaf0;border:1rpx solid #eadfc8}.relationship-action{margin-top:14rpx;padding:14rpx 16rpx;border-radius:14rpx;background:#fff3c9;color:#6f5418;font-size:24rpx}.evidence-list{overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.evidence-item{padding:22rpx;border-bottom:1rpx solid var(--line-soft)}.evidence-item:last-child{border-bottom:0}.evidence-date{color:var(--muted);font-size:21rpx}.evidence-title{margin-top:4rpx;font-size:27rpx;font-weight:800}.evidence-content{margin-top:6rpx;color:var(--ink-soft);font-size:24rpx;line-height:1.6}.bottom-action{margin-top:26rpx}
