.page { min-height: 100vh; padding: 28rpx 28rpx 60rpx; background: #f7f1df; box-sizing: border-box; }
.head { padding: 8rpx 4rpx 24rpx; }
.head-title { font-size: 40rpx; font-weight: 800; color: #17464b; }
.head-sub { margin-top: 10rpx; color: #6e8084; font-size: 24rpx; line-height: 1.7; }
.tabs { display: flex; gap: 14rpx; margin-bottom: 20rpx; }
.tab { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #fffdf7; border: 1rpx solid #e8ddc5; color: #6e8084; font-size: 26rpx; font-weight: 700; }
.tab.active { background: #0f766e; border-color: #0f766e; color: #ffffff; }
.card { padding: 28rpx; border-radius: 20rpx; background: #fffdf7; border: 1rpx solid #ece2cb; box-shadow: 0 10rpx 24rpx rgba(30, 80, 72, 0.06); margin-bottom: 22rpx; }
.card.center { text-align: center; }
.label { font-size: 24rpx; font-weight: 700; color: #4d6367; margin-bottom: 14rpx; }
.input { height: 84rpx; padding: 0 22rpx; border-radius: 14rpx; background: #ffffff; border: 1rpx solid #e7ddc6; font-size: 28rpx; color: #1d3238; }
.input.code { letter-spacing: 12rpx; font-size: 36rpx; font-weight: 800; }
.hint { margin-top: 14rpx; color: #8b9799; font-size: 22rpx; line-height: 1.7; }
.btn { margin-top: 26rpx; height: 88rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; }
.btn.primary { background: #0f766e; color: #ffffff; }
.btn::after { border: none; }
.wait-icon { width: 96rpx; height: 96rpx; margin: 0 auto 18rpx; border-radius: 50%; background: #fdf0d4; color: #b8791a; font-size: 34rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.wait-title { font-size: 32rpx; font-weight: 800; color: #17464b; }
.wait-sub { margin-top: 12rpx; color: #6e8084; font-size: 24rpx; line-height: 1.7; }
.family-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #f0e7d3; }
.family-row:last-child { border-bottom: none; }
.family-name { font-size: 28rpx; font-weight: 700; color: #1d3238; }
.family-meta { margin-top: 6rpx; color: #8b9799; font-size: 22rpx; }
.family-enter { padding: 10rpx 24rpx; border-radius: 999rpx; background: #e4f3ef; color: #0f766e; font-size: 24rpx; font-weight: 700; }
.request-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #f0e7d3; }
.request-row:last-child { border-bottom: none; }
.request-name { font-size: 27rpx; font-weight: 700; color: #1d3238; }
.request-meta { margin-top: 6rpx; color: #8b9799; font-size: 22rpx; }
.request-actions { display: flex; gap: 12rpx; }
.mini-btn { padding: 10rpx 22rpx; border-radius: 12rpx; background: #e4f3ef; color: #0f766e; font-size: 23rpx; font-weight: 700; }
.mini-btn.danger { background: #fdeceb; color: #c64b38; }
.pending-row { padding: 14rpx 0; color: #6e8084; font-size: 24rpx; }
.error { margin-top: 8rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #fdeceb; color: #c64b38; font-size: 24rpx; line-height: 1.6; }
