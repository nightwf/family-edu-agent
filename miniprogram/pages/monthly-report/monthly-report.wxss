.report-page{background:#f5efdf}.report-paper{overflow:hidden;border:1rpx solid #e4d7bc;border-radius:24rpx;background:#fffdf7;box-shadow:0 18rpx 48rpx rgba(55,50,36,.09)}.report-cover{padding:42rpx 30rpx;background:linear-gradient(135deg,#0f766e,#225f62);color:#fff}.report-type{color:#d5ebe5;font-size:22rpx;font-weight:800}.report-title{margin-top:12rpx;font-size:42rpx;font-weight:900;line-height:1.3}.report-date{margin-top:18rpx;color:#d6e8e5;font-size:23rpx}.report-lead,.report-body{margin:28rpx;padding:26rpx;border-radius:20rpx}.report-lead{border-left:8rpx solid var(--gold);background:var(--gold-soft)}.report-body{border:1rpx solid var(--line);background:#fff}.report-label{color:var(--teal);font-size:23rpx;font-weight:900}.report-summary,.report-body text{display:block;margin-top:12rpx;color:var(--ink-soft);font-size:28rpx;line-height:1.85;white-space:pre-wrap;word-break:break-word}.report-note{margin:0 28rpx 32rpx;padding-top:20rpx;border-top:1rpx solid var(--line);color:var(--muted);font-size:22rpx;line-height:1.6}
