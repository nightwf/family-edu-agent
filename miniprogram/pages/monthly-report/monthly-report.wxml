<view class="page report-page"><view wx:if="{{error}}" class="error-tip">{{error}}</view><view wx:if="{{loading}}" class="loading-block">正在打开报告...</view><view wx:elif="{{report}}" class="report-paper"><view class="report-cover"><view class="report-type">{{report.typeText}}</view><view class="report-title">{{report.title || '成长报告'}}</view><view class="report-date">{{report.dateText}}</view></view><view class="report-lead"><view class="report-label">本期摘要</view><view class="report-summary">{{report.summary || '本期暂无摘要'}}</view></view><view class="report-body"><view class="report-label">完整报告</view><text user-select="true">{{report.content || '暂无完整报告内容'}}</text></view><view class="report-note">报告由 WorkBuddy 根据已同步记录生成，请结合原始记录和孩子当下情况理解。</view></view><view wx:else class="empty">没有找到这份报告，可能已被删除或不属于当前家庭</view></view>
