<view class="page settings-home"><view wx:if="{{error}}" class="error-tip">{{error}}</view><view wx:if="{{loading}}" class="loading-block">正在读取家庭设置...</view><block wx:else><view class="account-card"><image src="/assets/illustrations/family-diorama.png" mode="aspectFit"/><view class="account-main"><view class="account-name">{{family.name || '我的家庭'}}</view><view class="account-meta">{{childCount}} 个孩子 · {{isWechatBound?'微信已绑定':'待绑定微信'}}</view></view></view><view class="setting-block"><view class="group-title">家庭与成员</view><view class="menu-card"><view class="menu-row" bindtap="goFamily"><view class="menu-icon gold">家</view><view class="menu-main"><view class="menu-title">家庭管理</view><view class="menu-desc">管理者、家庭编码、加入申请</view></view><view class="menu-arrow">›</view></view></view></view><view class="setting-block"><view class="group-title">AI 与教育方向</view><view class="menu-card"><view class="menu-row" data-section="connection" bindtap="goDetail"><view class="menu-icon teal">连</view><view class="menu-main"><view class="menu-title">WorkBuddy 连接</view><view class="menu-desc">{{connectionCount}} 个已授权连接</view></view><view class="menu-arrow">›</view></view><view class="menu-row" data-section="education" bindtap="goDetail"><view class="menu-icon gold">育</view><view class="menu-main"><view class="menu-title">家庭教育方向</view><view class="menu-desc">时间、压力边界和家长目标</view></view><view class="menu-arrow">›</view></view></view></view><view class="setting-block"><view class="group-title">账号安全</view><view class="menu-card"><view class="menu-row" data-section="account" bindtap="goDetail"><view class="menu-icon teal">帐</view><view class="menu-main"><view class="menu-title">账号与绑定</view><view class="menu-desc">{{user.email || '微信账号'}}</view></view><view class="menu-arrow">›</view></view></view></view><button class="logout-button" bindtap="logout">退出当前账号</button></block></view>
