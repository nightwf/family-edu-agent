.account-card{display:flex;align-items:center;gap:18rpx;padding:20rpx 24rpx;border-radius:28rpx;background:linear-gradient(135deg,#176f69,#205159);color:#fff;box-shadow:0 18rpx 42rpx rgba(18,91,85,.18)}.account-card image{width:150rpx;height:150rpx}.account-main{min-width:0;flex:1}.account-name{font-size:35rpx;font-weight:900}.account-meta{margin-top:8rpx;color:#d5e9e5;font-size:23rpx}.setting-block{margin-top:30rpx}.group-title{margin:0 4rpx 12rpx;color:var(--ink-soft);font-size:24rpx;font-weight:800}.menu-card{overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel);box-shadow:var(--shadow-soft)}.menu-row{display:flex;align-items:center;gap:16rpx;min-height:108rpx;padding:18rpx 20rpx;border-bottom:1rpx solid var(--line-soft)}.menu-row:last-child{border-bottom:0}.menu-icon{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:19rpx;font-size:23rpx;font-weight:900}.menu-icon.teal{background:var(--teal-soft);color:var(--teal)}.menu-icon.gold{background:var(--gold-soft);color:#85621b}.menu-main{min-width:0;flex:1}.menu-title{font-size:28rpx;font-weight:800}.menu-desc{margin-top:4rpx;color:var(--muted);font-size:22rpx}.menu-arrow{color:var(--muted);font-size:38rpx}.logout-button{width:100%;min-height:88rpx;margin-top:34rpx;border:1rpx solid #f0c4b8;border-radius:18rpx;background:#fff7f3;color:var(--accent);font-size:27rpx;font-weight:800}
