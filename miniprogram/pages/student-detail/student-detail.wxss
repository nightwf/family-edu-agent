.profile-hero{display:flex;align-items:center;gap:20rpx;padding:20rpx 26rpx;border-radius:28rpx;background:linear-gradient(135deg,#e2f2ed,#fff4cf)}.profile-hero image{width:160rpx;height:210rpx}.profile-hero .tag-group{margin-top:12rpx}.state-link{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-top:22rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel);box-shadow:var(--shadow-soft)}.state-title{margin-top:4rpx;font-size:30rpx;font-weight:900}.student-stats{margin-top:18rpx;grid-template-columns:repeat(3,minmax(0,1fr))}.student-stats .stat-card{min-height:122rpx;padding:18rpx 12rpx}.student-stats .stat-value{font-size:34rpx}.info-list{overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.info-row{display:flex;justify-content:space-between;gap:30rpx;padding:22rpx;border-bottom:1rpx solid var(--line-soft);font-size:25rpx}.info-row:last-child{border-bottom:0}.info-row text{color:var(--muted)}.info-row view{text-align:right;font-weight:700}.detail-actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:24rpx}.row-chevron{font-size:40rpx;color:var(--muted)}
