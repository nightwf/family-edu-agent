<view class="page"><view wx:if="{{error}}" class="error-tip">{{error}}</view><view wx:if="{{loading}}" class="loading-block">正在读取学生档案...</view><block wx:else><view class="profile-hero"><image src="/assets/illustrations/child-stable.png" mode="aspectFit"/><view><view class="title">{{child.name}}</view><view class="page-subtitle">{{child.age || '-'}} 岁 · {{child.grade || '未设置年级'}}</view><view class="tag-group"><view wx:for="{{child.subjects}}" wx:key="*this" class="tag tag-teal">{{item}}</view></view></view></view><view class="state-link" bindtap="goState"><view><view class="page-eyebrow">当前状态</view><view class="state-title">{{hero.title}}</view><view class="page-subtitle">{{hero.subtitle}}</view></view><view class="row-chevron">›</view></view><view class="stat-grid student-stats"><view wx:for="{{stats}}" wx:key="label" class="stat-card"><view class="muted">{{item.label}}</view><view class="stat-value">{{item.value}}</view></view></view><view class="section-head"><view class="section-title">基础资料</view></view><view class="info-list"><view class="info-row"><text>教材版本</text><view>{{child.textbookVersion || '未设置'}}</view></view><view class="info-row"><text>关注学科</text><view>{{child.subjectsText}}</view></view><view class="info-row"><text>档案状态</text><view>{{child.status === 'active' ? '使用中' : child.status}}</view></view></view><view class="detail-actions"><button class="btn btn-outline" bindtap="goGrowth">成长记录</button><button class="btn btn-primary" bindtap="goLearning">学习诊断</button></view></block></view>
