.home-page {
  padding-top: 28rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 15% 0%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0) 34%),
    linear-gradient(180deg, #f8f1df 0%, #fffaf0 100%);
}

.home-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.home-hello {
  min-width: 0;
  flex: 1;
}

.home-kicker {
  overflow: hidden;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-title {
  margin-top: 2rpx;
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.child-switch {
  min-width: 0;
  height: 66rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 18rpx 0 12rpx;
  border: 1rpx solid #dbeee9;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: var(--teal);
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(24, 92, 86, 0.07);
}

.muted-switch {
  padding-right: 16rpx;
}

.switch-avatar {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #dff2ed;
  color: var(--teal);
  font-size: 24rpx;
  font-weight: 900;
}

.switch-arrow {
  margin-left: -4rpx;
  color: #4f9b93;
  font-size: 22rpx;
}

.state-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 34rpx 32rpx;
  border-radius: 34rpx;
  background: var(--teal);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx rgba(15, 118, 110, 0.22);
}

.state-card::after {
  content: "";
  position: absolute;
  right: -60rpx;
  top: -48rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 78rpx;
  background: rgba(243, 201, 105, 0.18);
  transform: rotate(20deg);
}

.state-head,
.state-title,
.state-summary,
.state-row {
  position: relative;
  z-index: 1;
}

.state-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.state-label,
.state-date {
  color: #cfe4df;
  font-size: 23rpx;
  font-weight: 700;
}

.state-date {
  flex-shrink: 0;
}

.state-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 45rpx;
  font-weight: 900;
  line-height: 1.24;
}

.state-summary {
  width: 82%;
  margin-top: 18rpx;
  color: #e2f0ed;
  font-size: 26rpx;
  line-height: 1.62;
}

.state-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 28rpx;
}

.state-stat {
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.state-stat-value {
  overflow: hidden;
  color: #ffffff;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-stat-label {
  margin-top: 8rpx;
  color: #cfe4df;
  font-size: 20rpx;
  line-height: 1.2;
}

.goal-card {
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
  border: 1rpx solid #eadfb9;
  border-radius: 28rpx;
  background: #fff7dc;
  color: var(--ink);
}

.goal-label {
  color: #9a7421;
  font-size: 22rpx;
  font-weight: 800;
}

.goal-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.goal-summary {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.relation-card {
  margin-top: 18rpx;
  padding: 26rpx 30rpx;
  border: 1rpx solid #f1d9a7;
  border-radius: 28rpx;
  background: #fffaf0;
  color: var(--ink);
}

.relation-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.relation-score {
  color: #8a5a12;
  font-size: 23rpx;
  font-weight: 800;
}

.home-section {
  margin-top: 34rpx;
}

.compact-head {
  margin: 0 0 18rpx;
}

.home-section-title {
  position: relative;
  padding-left: 20rpx;
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.home-section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 9rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--gold);
}

.compact-link {
  min-height: 52rpx;
  font-size: 24rpx;
}

.task-stack {
  display: grid;
  gap: 18rpx;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 130rpx;
  padding: 22rpx 18rpx 22rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.9);
  box-shadow: var(--shadow-soft);
}

.task-icon {
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--gold-soft);
  color: #7b5b12;
  font-size: 31rpx;
  font-weight: 900;
}

.task-icon.coral {
  background: #ffe8df;
  color: var(--accent);
}

.task-icon.gold {
  background: var(--gold-soft);
  color: #7b5b12;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.32;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-status {
  flex-shrink: 0;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: #f8f1df;
  color: var(--muted);
  font-size: 21rpx;
  font-weight: 800;
}

.timeline {
  position: relative;
  padding-left: 22rpx;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 18rpx;
  bottom: 18rpx;
  width: 3rpx;
  border-radius: 999rpx;
  background: #e4d7bc;
}

.activity-card {
  position: relative;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.9);
  box-shadow: var(--shadow-soft);
}

.activity-card::before {
  content: "";
  position: absolute;
  left: -22rpx;
  top: 30rpx;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #f8f1df;
  border-radius: 50%;
  background: var(--teal);
}

.activity-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 700;
}

.activity-type {
  flex-shrink: 0;
}

.activity-time {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-title {
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.activity-text {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #52636a;
  font-size: 25rpx;
  line-height: 1.58;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.slim-empty {
  min-height: 150rpx;
  padding: 36rpx 28rpx;
  font-size: 25rpx;
}

.home-actions {
  margin-top: 28rpx;
}
