.home-page{padding-top:22rpx;background:linear-gradient(180deg,#f8f2df 0%,#fffaf0 62%,#f7f1df 100%)}
.home-nav{min-height:80rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:18rpx}.nav-date{color:var(--muted);font-size:22rpx}.nav-title{margin-top:2rpx;font-size:35rpx;font-weight:900;line-height:1.2}
.child-picker-pill{min-height:60rpx;display:flex;align-items:center;gap:8rpx;padding:0 20rpx;border:1rpx solid #d7e7e2;border-radius:999rpx;background:rgba(255,255,255,.86);color:var(--teal);font-size:24rpx;font-weight:800}.child-picker-pill.quiet{color:#58716f}
.hero-stage{position:relative;min-height:660rpx;overflow:hidden;border-radius:32rpx;background-color:#d9eee7;background-position:center;background-size:cover;box-shadow:0 24rpx 54rpx rgba(37,75,70,.16)}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,70,66,.72) 0%,rgba(16,70,66,.06) 44%,rgba(26,58,56,.42) 100%)}
.hero-copy{position:relative;z-index:2;width:82%;padding:34rpx 32rpx 0;color:#fff}.hero-kicker{color:#d8eee8;font-size:22rpx;font-weight:700}.hero-title{margin-top:6rpx;font-size:43rpx;font-weight:900;line-height:1.2}.hero-subtitle{margin-top:10rpx;color:rgba(255,255,255,.88);font-size:25rpx;line-height:1.5}.hero-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.hero-tag{padding:7rpx 14rpx;border:1rpx solid rgba(255,255,255,.32);border-radius:999rpx;background:rgba(13,75,69,.46);color:#fff;font-size:21rpx}
.hero-child{position:absolute;z-index:1;left:50%;bottom:22rpx;width:350rpx;height:510rpx;transform:translateX(-50%);transform-origin:50% 100%}.hero-child.is-animated{animation:child-breathe 3.6s ease-in-out infinite}@keyframes child-breathe{0%,100%{transform:translateX(-50%) translateY(0) scale(1)}50%{transform:translateX(-50%) translateY(-8rpx) scale(1.012)}}
.hero-detail{position:absolute;z-index:3;right:24rpx;bottom:22rpx;min-height:54rpx;display:flex;align-items:center;gap:6rpx;padding:0 16rpx;border-radius:999rpx;background:rgba(255,253,247,.9);color:var(--teal);font-size:22rpx;font-weight:800}.hero-detail text{font-size:30rpx}
.insight-card{margin-top:22rpx;padding:28rpx;border:1rpx solid #eadfc8;border-radius:26rpx;background:#fffdf7;box-shadow:var(--shadow-soft)}.insight-top{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.card-kicker{color:var(--accent);font-size:22rpx;font-weight:800}.insight-title{margin-top:5rpx;font-size:34rpx;font-weight:900;line-height:1.3}.insight-score{flex-shrink:0;color:var(--teal);font-size:44rpx;font-weight:900;line-height:1}.insight-score text{margin-left:2rpx;font-size:20rpx}
.evidence-row{display:grid;grid-template-columns:76rpx minmax(0,1fr);gap:12rpx;margin-top:18rpx;color:var(--ink-soft);font-size:24rpx;line-height:1.55}.evidence-row text{color:var(--muted);font-size:22rpx;font-weight:700}.action-box{position:relative;margin-top:22rpx;padding:22rpx 56rpx 22rpx 22rpx;border-radius:20rpx;background:var(--teal-soft)}.action-label{color:var(--teal);font-size:21rpx;font-weight:800}.action-text{margin-top:6rpx;color:var(--ink);font-size:26rpx;font-weight:700;line-height:1.55}.action-arrow{position:absolute;right:20rpx;top:50%;color:var(--teal);font-size:42rpx;transform:translateY(-50%)}
.home-section{margin-top:34rpx}.compact-head{margin:0 0 14rpx}.home-section-title{font-size:31rpx;font-weight:900}.change-list,.task-list{overflow:hidden;border:1rpx solid var(--line);border-radius:24rpx;background:#fffdf7;box-shadow:var(--shadow-soft)}.change-row,.task-row{display:flex;align-items:center;gap:16rpx;min-height:118rpx;padding:20rpx 22rpx;border-bottom:1rpx solid var(--line-soft);box-sizing:border-box}.change-row:last-child,.task-row:last-child{border-bottom:0}.change-mark{width:14rpx;height:58rpx;flex-shrink:0;border-radius:999rpx;background:linear-gradient(180deg,var(--gold),var(--teal))}.change-main,.task-main{min-width:0;flex:1}.change-label{color:var(--teal);font-size:20rpx;font-weight:800}.change-title,.task-title{margin-top:2rpx;overflow:hidden;font-size:27rpx;font-weight:800;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}.change-text,.task-time{margin-top:5rpx;overflow:hidden;color:var(--muted);font-size:22rpx;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}.row-chevron{flex-shrink:0;color:#9aa5a5;font-size:38rpx}.task-subject{width:70rpx;height:70rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:var(--gold-soft);color:#7f5c13;font-size:28rpx;font-weight:900}
.home-skeleton{display:grid;gap:18rpx}.skeleton{background:linear-gradient(90deg,#efe7d6,#faf6ec,#efe7d6);background-size:220% 100%;animation:shimmer 1.4s linear infinite}.hero-skeleton{height:660rpx;border-radius:32rpx}.line-skeleton{height:130rpx;border-radius:24rpx}.line-skeleton.short{height:90rpx}@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}.home-empty{margin-top:24rpx;flex-direction:column;gap:20rpx}.home-empty .btn{width:240rpx}
