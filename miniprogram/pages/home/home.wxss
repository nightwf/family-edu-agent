.home-page{padding-top:22rpx;background:linear-gradient(180deg,#f8f2df 0%,#fffaf0 62%,#f7f1df 100%)}

.home-nav{min-height:80rpx;display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:18rpx}
.nav-date{color:var(--muted);font-size:22rpx}
.nav-title{margin-top:2rpx;font-size:35rpx;font-weight:900;line-height:1.2}
.child-picker-pill{min-height:60rpx;display:flex;align-items:center;gap:8rpx;padding:0 20rpx;border:1rpx solid #d7e7e2;border-radius:999rpx;background:rgba(255,255,255,.86);color:var(--teal);font-size:24rpx;font-weight:800}
.child-picker-pill.quiet{color:#58716f}

/* 顶部整体状态：保留人物与场景，但结论优先 */
.hero-subject{position:relative;overflow:hidden;border-radius:32rpx;padding:30rpx 28rpx 24rpx;min-height:430rpx;background-color:#d9eee7;background-position:center;background-size:cover;box-shadow:0 24rpx 54rpx rgba(37,75,70,.16);display:flex;flex-direction:column;justify-content:space-between}
.hero-shade{position:absolute;inset:0;background:linear-gradient(120deg,rgba(12,58,55,.94) 0%,rgba(16,70,66,.88) 44%,rgba(26,86,79,.46) 100%)}
.hero-copy{position:relative;z-index:2;width:72%;color:#fff}
.hero-kicker{color:#cfe7e2;font-size:22rpx;font-weight:800}
.hero-title{margin-top:10rpx;font-size:39rpx;font-weight:900;line-height:1.32}
.hero-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}
.hero-tag{padding:6rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.18);color:#fff;font-size:21rpx;font-weight:700}
.hero-child{position:absolute;z-index:1;right:-10rpx;bottom:112rpx;width:270rpx;height:400rpx;transform-origin:50% 100%}
.hero-child.is-animated{animation:child-breathe 3.6s ease-in-out infinite}
@keyframes child-breathe{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-10rpx) scale(1.014)}}
.hero-metrics{position:relative;z-index:2;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;padding:16rpx 12rpx;border-radius:20rpx;background:rgba(255,255,255,.16)}
.hero-metrics view{text-align:center;color:#fff}
.hero-metrics text{display:block;color:var(--gold);font-size:34rpx;font-weight:900}
.hero-metrics view view{margin-top:4rpx;color:#dceceb;font-size:19rpx}

/* 区块标题 */
.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin:34rpx 0 14rpx;padding:0 2rpx}
.compact-head{margin-top:30rpx}
.home-section-title{font-size:31rpx;font-weight:900}
.section-link{color:var(--teal);font-size:23rpx;font-weight:800}

/* 学科列表（首页主体） */
.subject-list{display:flex;flex-direction:column;gap:16rpx}
.subject{padding:24rpx;border:1rpx solid var(--line);border-radius:26rpx;background:#fffdf7;box-shadow:var(--shadow-soft)}
.subject.is-focus{border-color:#ecc7ba;background:#fff7f3}
.subject-top{display:flex;align-items:center;gap:14rpx}
.subject-name{font-size:33rpx;font-weight:900}
.subject-state{padding:6rpx 14rpx;border-radius:999rpx;background:var(--gold-soft);color:#80601a;font-size:21rpx;font-weight:800}
.subject.is-focus .subject-state{background:var(--accent-soft);color:var(--accent)}
.subject.is-progress .subject-state{background:var(--teal-soft);color:var(--teal)}
.subject.is-thin .subject-state{background:#eef1f0;color:#6d7c80}
.subject-score{margin-left:auto;color:var(--teal);font-size:34rpx;font-weight:900}
.subject.is-focus .subject-score{color:var(--accent)}
.subject-score text{margin-left:2rpx;color:var(--muted);font-size:20rpx;font-weight:700}
.subject-bar{height:10rpx;margin-top:16rpx;overflow:hidden;border-radius:999rpx;background:#eef2f0}
.subject-bar-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,var(--teal),#3aa79a)}
.subject.is-focus .subject-bar-fill{background:linear-gradient(90deg,#d3644c,#e79b7f)}
.subject-meta{margin-top:14rpx;color:var(--muted);font-size:22rpx}
.subject-change{margin-top:10rpx;color:var(--ink-soft);font-size:23rpx;line-height:1.55}
.subject-enter{margin-top:16rpx;padding-top:14rpx;border-top:1rpx solid var(--line-soft);color:var(--teal);font-size:23rpx;font-weight:800;display:flex;align-items:center;justify-content:space-between}
.subject-enter text{color:#9aa5a5;font-size:32rpx}

/* 待规划提示 */
.plan-card{margin-top:30rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:26rpx;background:#fffdf7;box-shadow:var(--shadow-soft)}
.plan-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.card-kicker{color:var(--accent);font-size:22rpx;font-weight:800}
.plan-status{flex:none;padding:7rpx 16rpx;border-radius:999rpx;background:var(--gold-soft);color:#7d5a12;font-size:20rpx;font-weight:800}
.plan-cta{display:flex;align-items:center;gap:18rpx;margin-top:14rpx;padding:20rpx 22rpx;border-radius:20rpx;background:var(--gold-soft)}
.plan-main{min-width:0;flex:1}
.plan-title{font-size:27rpx;font-weight:900}
.plan-reason{margin-top:6rpx;color:#7d5a12;font-size:22rpx;line-height:1.5}
.plan-button{flex:none;min-height:64rpx;padding:0 22rpx;font-size:23rpx}
.plan-draft{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid var(--line-soft)}
.plan-summary{font-size:25rpx;font-weight:900;line-height:1.45}
.plan-rationale{margin-top:8rpx;color:var(--muted);font-size:21rpx;line-height:1.55}
.plan-items{display:grid;gap:12rpx;margin-top:16rpx}
.plan-item{padding:16rpx 18rpx;border-radius:18rpx;background:#fff}
.plan-item-title{font-size:23rpx;font-weight:800;line-height:1.45}
.plan-item-meta{margin-top:5rpx;color:var(--muted);font-size:20rpx}
.plan-error{margin-top:14rpx;color:var(--accent);font-size:22rpx;line-height:1.5}

@media (max-width:360px){.plan-cta{align-items:stretch;flex-direction:column}.plan-button{width:100%}}

/* 最近任务 */
.home-section{margin-top:34rpx}
.task-list{overflow:hidden;border:1rpx solid var(--line);border-radius:24rpx;background:#fffdf7;box-shadow:var(--shadow-soft)}
.task-row{display:flex;align-items:center;gap:16rpx;min-height:118rpx;padding:20rpx 22rpx;border-bottom:1rpx solid var(--line-soft);box-sizing:border-box}
.task-row:last-child{border-bottom:0}
.task-subject{width:70rpx;height:70rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:22rpx;background:var(--gold-soft);color:#7f5c13;font-size:28rpx;font-weight:900}
.task-main{min-width:0;flex:1}
.task-title{margin-top:2rpx;overflow:hidden;font-size:27rpx;font-weight:800;line-height:1.35;text-overflow:ellipsis;white-space:nowrap}
.task-time{margin-top:5rpx;overflow:hidden;color:var(--muted);font-size:22rpx;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}
.row-chevron{flex-shrink:0;color:#9aa5a5;font-size:38rpx}

.home-skeleton{display:grid;gap:18rpx}
.skeleton{background:linear-gradient(90deg,#efe7d6,#faf6ec,#efe7d6);background-size:220% 100%;animation:shimmer 1.4s linear infinite}
.hero-skeleton{height:430rpx;border-radius:32rpx}
.line-skeleton{height:200rpx;border-radius:26rpx}
.line-skeleton.short{height:130rpx}
@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}
.home-empty{margin-top:24rpx;flex-direction:column;gap:20rpx}
.home-empty .btn{width:240rpx}
