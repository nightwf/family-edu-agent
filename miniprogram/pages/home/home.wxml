<view class="page home-page">
  <view wx:if="{{error}}" class="error-tip">{{error}}</view>

  <view class="home-topbar">
    <view class="home-hello">
      <view class="home-kicker">{{focusText}}</view>
      <view class="home-title">{{family && family.name ? family.name : '禾芽家庭教务'}}</view>
    </view>
    <picker wx:if="{{children.length > 1}}" mode="selector" range="{{childNames}}" value="{{childIndex}}" bindchange="onChildChange">
      <view class="child-switch">
        <view class="switch-avatar">{{activeChild.initial}}</view>
        <text>{{activeChild.name}}</text>
        <text class="switch-arrow">⌄</text>
      </view>
    </picker>
    <view wx:elif="{{activeChild}}" class="child-switch muted-switch">
      <view class="switch-avatar">{{activeChild.initial}}</view>
      <text>{{activeChild.name}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty slim-empty">正在读取家庭学习数据...</view>

  <block wx:else>
    <view class="state-card">
      <view class="state-head">
        <view class="state-label">当前状态总结</view>
        <view class="state-date">{{todayText}}</view>
      </view>
      <view class="state-title">{{stateTitle}}</view>
      <view class="state-summary">{{stateSummary}}</view>
      <view class="state-row">
        <view wx:for="{{currentStats}}" wx:key="label" class="state-stat">
          <view class="state-stat-value">{{item.value}}</view>
          <view class="state-stat-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeGoal}}" class="goal-card">
      <view class="goal-label">当前阶段目标</view>
      <view class="goal-title">{{activeGoal.title}}</view>
      <view class="goal-summary">{{activeGoal.objective}}</view>
    </view>

    <view class="home-section">
      <view class="section-head compact-head">
        <view class="home-section-title">未完成任务</view>
        <view class="section-link compact-link" bindtap="goHomework">全部任务</view>
      </view>
      <view wx:if="{{pendingTasks.length}}" class="task-stack">
        <view wx:for="{{pendingTasks}}" wx:key="id" class="task-card" bindtap="goHomework">
          <view class="task-icon {{item.tone}}">{{item.icon}}</view>
          <view class="task-main">
            <view class="task-title">{{item.title}}</view>
            <view class="task-meta">{{item.dueText}} · {{item.sourceText}}</view>
          </view>
          <view class="task-status">{{item.statusText}}</view>
        </view>
      </view>
      <view wx:else class="empty slim-empty">当前没有未完成任务</view>
    </view>

    <view class="home-section">
      <view class="section-head compact-head">
        <view class="home-section-title">最新成长动态</view>
        <view class="section-link compact-link" bindtap="goGrowth">成长页</view>
      </view>
      <view wx:if="{{activityItems.length}}" class="timeline">
        <view wx:for="{{activityItems}}" wx:key="id" class="activity-card" bindtap="goGrowth">
          <view class="activity-top">
            <view class="activity-type">{{item.type}}</view>
            <view class="activity-time">{{item.timeText}}</view>
          </view>
          <view class="activity-title">{{item.title}}</view>
          <view class="activity-text">{{item.text}}</view>
        </view>
      </view>
      <view wx:else class="empty slim-empty">暂无成长动态，WorkBuddy 同步后会显示在这里</view>
    </view>

    <view wx:if="{{!activeChild}}" class="home-actions">
      <button class="btn btn-primary" bindtap="goStudents">添加学生档案</button>
    </view>
  </block>
</view>
