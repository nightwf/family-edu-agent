<view class="page"><view wx:if="{{error}}" class="error-tip">{{error}}</view><view class="page-heading"><view class="page-eyebrow">{{child ? child.name : '孩子'}}的学习诊断</view><view class="title">薄弱点与加强顺序</view><view class="page-subtitle">结论只来自已同步的错题和练习证据</view></view><view wx:if="{{loading}}" class="loading-block">正在整理薄弱证据...</view><block wx:else><view wx:if="{{wrong.length}}" class="weak-list"><view wx:for="{{wrong}}" wx:key="id" class="weak-card"><view class="between"><view class="weak-rank">优先 {{index+1}}</view><view class="pill pill-warn">{{item.statusText}}</view></view><view class="weak-title">{{item.name}}</view><view class="weak-row"><text>错误原因</text><view>{{item.reasonText}}</view></view><view class="weak-row"><text>复测安排</text><view>{{item.reviewText}}</view></view><view class="weak-plan">建议顺序：订正原题 → 解释错误原因 → 同型变式 → 延迟复测</view></view></view><view wx:else class="empty">目前没有待处理错题，不能据此判断具体薄弱点</view><view class="section-head"><view class="section-title">题型掌握度</view></view><view wx:if="{{mastery.length}}" class="mastery-list"><view wx:for="{{mastery}}" wx:key="id" class="mastery-row"><view class="mastery-main"><view class="mastery-name">{{item.name}}</view><view class="muted">{{item.statusText}}</view><view class="progress"><view class="progress-fill" style="width:{{item.score}}%"></view></view></view><view class="mastery-score">{{item.score}}</view></view></view><view wx:else class="empty">还没有可用的题型掌握记录</view><button class="btn btn-primary bottom-action" bindtap="goWrongBook">进入错题本</button></block></view>
