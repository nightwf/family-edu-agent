.weak-list{display:grid;gap:16rpx}.weak-card{padding:24rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel);box-shadow:var(--shadow-soft)}.weak-rank{color:var(--accent);font-size:22rpx;font-weight:800}.weak-title{margin-top:10rpx;font-size:31rpx;font-weight:900}.weak-row{display:grid;grid-template-columns:112rpx 1fr;gap:12rpx;margin-top:16rpx;font-size:24rpx;line-height:1.55}.weak-row text{color:var(--muted)}.weak-plan{margin-top:18rpx;padding:16rpx;border-radius:16rpx;background:var(--teal-soft);color:var(--teal);font-size:23rpx;line-height:1.55}.mastery-list{overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.mastery-row{display:flex;align-items:center;gap:18rpx;padding:22rpx;border-bottom:1rpx solid var(--line-soft)}.mastery-row:last-child{border-bottom:0}.mastery-main{min-width:0;flex:1}.mastery-name{font-size:27rpx;font-weight:800}.mastery-main .muted{margin:4rpx 0 10rpx;font-size:22rpx}.mastery-score{width:74rpx;color:var(--teal);font-size:36rpx;font-weight:900;text-align:right}.bottom-action{margin-top:26rpx}
