.header {
  margin-bottom: 26rpx;
}

.add-btn {
  min-height: 64rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 800;
}

.version {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.error-tip {
  background: #ffeae4;
  color: #c9503a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 18rpx;
  font-size: 26rpx;
}
