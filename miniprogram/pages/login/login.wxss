.login-page {
  min-height: 100vh;
  padding: 80rpx 40rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f6f0dc 0%, #fffaf0 100%);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 50rpx;
}

.brand-mark {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f3c969;
  color: #23353b;
  font-size: 60rpx;
  font-weight: 800;
}

.brand-name {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #23353b;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #7a8a90;
}

.login-card {
  background: #fffaf0;
  border: 1rpx solid #e8ddc5;
  border-radius: 24rpx;
  padding: 34rpx 30rpx;
  box-shadow: 0 12rpx 30rpx rgba(35, 53, 59, 0.06);
}

.mode-tabs {
  display: flex;
  background: #f1e9d8;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 34rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: #7a8a90;
  font-size: 28rpx;
  font-weight: 600;
}

.mode-tab.active {
  background: #0f766e;
  color: #ffffff;
}

.or-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 32rpx 0 26rpx;
  color: #a59a86;
  font-size: 24rpx;
}

.line {
  flex: 1;
  height: 1rpx;
  background: #e8ddc5;
}

.wechat-btn {
  background: #07c160;
  color: #ffffff;
}

.bind-tip {
  margin-bottom: 26rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #e4f3ef;
  color: #0f766e;
  font-size: 26rpx;
}

.bind-modes {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.bind-mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border: 1rpx solid #e8ddc5;
  border-radius: 12rpx;
  color: #7a8a90;
  font-size: 26rpx;
}

.bind-mode.active {
  border-color: #0f766e;
  background: #e4f3ef;
  color: #0f766e;
  font-weight: 700;
}

.error {
  margin-top: 24rpx;
  color: #c9503a;
  font-size: 26rpx;
  text-align: center;
}
