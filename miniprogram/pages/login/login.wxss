.login-page {
  min-height: 100vh;
  padding: calc(50rpx + env(safe-area-inset-top)) 32rpx 32rpx;
  box-sizing: border-box;
  background: #f7f1df;
}

.brand { display: flex; align-items: center; padding: 20rpx 8rpx 24rpx; }

.brand-mark {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #f3c969;
  color: #23353b;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(130, 97, 27, 0.16);
}

.seed-dot { position: absolute; top: 15rpx; right: 16rpx; width: 13rpx; height: 13rpx; border-radius: 12rpx 2rpx 12rpx 2rpx; background: #0f766e; transform: rotate(-24deg); }
.brand-copy { margin-left: 20rpx; }
.brand-name { color: #203238; font-size: 38rpx; font-weight: 800; }
.brand-sub { margin-top: 4rpx; color: #728186; font-size: 24rpx; }

.login-hero {
  margin: 10rpx 0 26rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f766e, #205159);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, 0.16);
}

.hero-line { color: #d3e0df; font-size: 23rpx; }
.hero-title { margin-top: 8rpx; font-size: 36rpx; font-weight: 800; line-height: 1.35; }

.login-sheet {
  padding: 32rpx 28rpx;
  border: 1rpx solid #e8ddc5;
  border-radius: 28rpx;
  background: #fffdf7;
  box-shadow: 0 14rpx 40rpx rgba(35, 53, 59, 0.08);
}

.sheet-title { font-size: 36rpx; font-weight: 800; }
.sheet-subtitle { margin-top: 4rpx; color: #728186; font-size: 24rpx; }

.wechat-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 28rpx 0 0;
  border-radius: 18rpx;
  background: #18ad63;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.wechat-mark { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.9); border-radius: 50%; font-size: 19rpx; line-height: 1; }

.or-line { display: flex; align-items: center; gap: 16rpx; margin: 28rpx 0 22rpx; color: #9a9f99; font-size: 21rpx; }
.line { flex: 1; height: 1rpx; background: #e8ddc5; }

.mode-tabs { display: flex; margin-bottom: 26rpx; padding: 5rpx; border-radius: 16rpx; background: #eee7d8; }
.mode-tab { min-height: 62rpx; flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #728186; font-size: 24rpx; font-weight: 600; }
.mode-tab.active { background: #ffffff; color: #0f766e; font-weight: 800; box-shadow: 0 4rpx 10rpx rgba(39, 54, 57, 0.07); }
.submit-button { margin-top: 8rpx; }

.bind-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin: 28rpx 0 24rpx; }
.bind-mode { min-height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #e8ddc5; border-radius: 16rpx; color: #728186; font-size: 24rpx; }
.bind-mode.active { border-color: #0f766e; background: #e4f3ef; color: #0f766e; font-weight: 700; }

.error { margin-top: 22rpx; padding: 14rpx; border-radius: 10rpx; background: #fff0eb; color: #c9503a; font-size: 24rpx; text-align: center; }
.login-footer { margin-top: 26rpx; color: #8b989a; font-size: 21rpx; text-align: center; }
