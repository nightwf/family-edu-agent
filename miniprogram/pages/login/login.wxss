.login-page {
  min-height: 100vh;
  padding: calc(50rpx + env(safe-area-inset-top)) 32rpx 32rpx;
  box-sizing: border-box;
  background: #f7f1df;
}

.brand { display: flex; align-items: center; padding: 20rpx 8rpx 24rpx; }

.brand-mark {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #f3c969;
  color: #23353b;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(130, 97, 27, 0.16);
}

.seed-dot { position: absolute; top: 15rpx; right: 16rpx; width: 13rpx; height: 13rpx; border-radius: 12rpx 2rpx 12rpx 2rpx; background: #0f766e; transform: rotate(-24deg); }
.brand-copy { margin-left: 20rpx; }
.brand-name { color: #203238; font-size: 38rpx; font-weight: 800; }
.brand-sub { margin-top: 4rpx; color: #728186; font-size: 24rpx; }

.login-hero {
  margin: 10rpx 0 26rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f766e, #205159);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, 0.16);
}

.hero-line { color: #d3e0df; font-size: 23rpx; }
.hero-title { margin-top: 8rpx; font-size: 36rpx; font-weight: 800; line-height: 1.35; }

.service-card {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 0 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e8ddc5;
  border-radius: 24rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 28rpx rgba(39, 54, 57, 0.06);
  box-sizing: border-box;
}

.service-card.ok {
  border-color: #cde8df;
  background: #f4fffb;
}

.service-card.checking {
  border-color: #f0dfad;
  background: #fff9e8;
}

.service-card.unstable {
  border-color: #f1c9bf;
  background: #fff5f1;
}

.service-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #e4f3ef;
}

.service-card.checking .service-icon { background: #fff0c9; }
.service-card.unstable .service-icon { background: #ffe0d7; }

.service-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #0f766e;
  box-shadow: 0 0 0 8rpx rgba(15, 118, 110, 0.12);
}

.service-card.checking .service-dot {
  background: #d89c22;
  box-shadow: 0 0 0 8rpx rgba(216, 156, 34, 0.14);
}

.service-card.unstable .service-dot {
  background: #c9503a;
  box-shadow: 0 0 0 8rpx rgba(201, 80, 58, 0.12);
}

.service-main {
  min-width: 0;
  flex: 1;
}

.service-title {
  color: #203238;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.28;
}

.service-detail {
  margin-top: 5rpx;
  color: #728186;
  font-size: 22rpx;
  line-height: 1.45;
}

.service-action {
  min-width: 84rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 800;
  box-shadow: inset 0 0 0 1rpx #e8ddc5;
}

.login-sheet {
  padding: 32rpx 28rpx;
  border: 1rpx solid #e8ddc5;
  border-radius: 28rpx;
  background: #fffdf7;
  box-shadow: 0 14rpx 40rpx rgba(35, 53, 59, 0.08);
}

.sheet-title { font-size: 36rpx; font-weight: 800; }
.sheet-subtitle { margin-top: 4rpx; color: #728186; font-size: 24rpx; }

.wechat-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 28rpx 0 0;
  border-radius: 18rpx;
  background: #18ad63;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.wechat-mark { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255, 255, 255, 0.9); border-radius: 50%; font-size: 19rpx; line-height: 1; }

.or-line { display: flex; align-items: center; gap: 16rpx; margin: 28rpx 0 22rpx; color: #9a9f99; font-size: 21rpx; }
.line { flex: 1; height: 1rpx; background: #e8ddc5; }

.mode-tabs { display: flex; margin-bottom: 26rpx; padding: 5rpx; border-radius: 16rpx; background: #eee7d8; }
.mode-tab { min-height: 62rpx; flex: 1; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; color: #728186; font-size: 24rpx; font-weight: 600; }
.mode-tab.active { background: #ffffff; color: #0f766e; font-weight: 800; box-shadow: 0 4rpx 10rpx rgba(39, 54, 57, 0.07); }
.submit-button { margin-top: 8rpx; }

.bind-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin: 28rpx 0 24rpx; }
.bind-mode { min-height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #e8ddc5; border-radius: 16rpx; color: #728186; font-size: 24rpx; }
.bind-mode.active { border-color: #0f766e; background: #e4f3ef; color: #0f766e; font-weight: 700; }

.error-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #f0c7bc;
  border-radius: 20rpx;
  background: #fff5f1;
}

.error-title {
  color: #9f3e2d;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.36;
}

.error-detail {
  margin-top: 8rpx;
  color: #b25b49;
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-word;
}

.error-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.error-action {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8ddc5;
  border-radius: 14rpx;
  background: #ffffff;
  color: #203238;
  font-size: 23rpx;
  font-weight: 800;
}

.error-action.primary {
  border-color: #0f766e;
  background: #e4f3ef;
  color: #0f766e;
}

.login-footer { margin-top: 26rpx; color: #8b989a; font-size: 21rpx; text-align: center; }
