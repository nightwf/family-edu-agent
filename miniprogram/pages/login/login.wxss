.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f7f1df;
}

/* 顶部品牌区，与导航栏同色，连成一条完整的色带 */
.hero {
  position: relative;
  height: 470rpx;
  flex-shrink: 0;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  background-color: #0f766e;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='230'%20height='200'%20viewBox='0%200%20230%20200'%20fill='none'%3E%3Cpath%20d='M4%20168C60%20150%2096%2096%20132%2060%20156%2036%20186%2022%20214%2016'%20stroke='%23ffffff'%20stroke-opacity='0.18'%20stroke-width='2.5'%20stroke-linecap='round'/%3E%3Cpath%20d='M132%2060c8-18%2026-28%2044-26-2%2018-18%2030-44%2026Z'%20fill='%23ffffff'%20fill-opacity='0.18'/%3E%3Cpath%20d='M74%20116c4-16%2020-24%2036-22-2%2016-16%2026-36%2022Z'%20fill='%23ffffff'%20fill-opacity='0.12'/%3E%3Ccircle%20cx='214'%20cy='16'%20r='5'%20fill='%23ffffff'%20fill-opacity='0.18'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right -28rpx bottom -40rpx;
  background-size: 460rpx 400rpx;
}

.hero-inner {
  display: flex;
  align-items: center;
  padding: 52rpx 60rpx 0;
}
.login-child{position:absolute;right:10rpx;bottom:-12rpx;width:270rpx;height:330rpx;filter:drop-shadow(0 14rpx 20rpx rgba(0,0,0,.12))}

.mark {
  position: relative;
  width: 124rpx;
  height: 124rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #f3c969;
  color: #23433f;
  font-size: 64rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.16);
}

.leaf {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 16rpx 2rpx 16rpx 2rpx;
  background: #0f766e;
  transform: rotate(-24deg);
}

.brand { position:relative;z-index:2;margin-left: 32rpx; min-width: 0; }
.brand-name { color: #ffffff; font-size: 42rpx; font-weight: 700; }
.brand-sub { width:360rpx;margin-top: 12rpx; color: rgba(255, 255, 255, 0.82); font-size: 25rpx;line-height:1.5 }

/* 登录面板，向上压住色带边缘 */
.sheet {
  position: relative;
  margin: -72rpx 40rpx 0;
  padding: 52rpx 44rpx 48rpx;
  border: 1rpx solid #ece2cb;
  border-radius: 44rpx;
  background: #fffdf7;
  box-shadow: 0 24rpx 60rpx rgba(23, 62, 62, 0.13);
}

.sheet-title {
  margin-bottom: 36rpx;
  color: #17464b;
  font-size: 36rpx;
  font-weight: 700;
}
.welcome-title{font-size:38rpx;font-weight:900;color:var(--ink)}
.welcome-sub{margin:6rpx 0 30rpx;color:var(--muted);font-size:24rpx}

.wechat-btn {
  width: 100%;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  border: none;
  border-radius: 32rpx;
  background: #18ad63;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 108rpx;
  box-shadow: 0 18rpx 40rpx rgba(24, 173, 99, 0.26);
}

.wechat-btn::after { border: none; }

.wechat-mark {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.divider {
  display: flex;
  align-items: center;
  margin-top: 44rpx;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: #ece2cb;
}

.divider-text {
  padding: 0 24rpx;
  color: #a8b1b0;
  font-size: 23rpx;
}

.link-center {
  margin-top: 32rpx;
  color: #4f6b6d;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}
.agreement{display:flex;align-items:center;justify-content:center;gap:10rpx;margin-top:24rpx;color:#7d898a;font-size:22rpx}.check{width:30rpx;height:30rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #b8c0bd;border-radius:8rpx;background:#fff;color:#fff;font-size:20rpx}.check.checked{border-color:var(--teal);background:var(--teal)}

.field { margin-bottom: 32rpx; }
.field-label { margin-bottom: 16rpx; color: #6d7c7e; font-size: 25rpx; font-weight: 600; }

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e6dcc5;
  border-radius: 26rpx;
  background: #ffffff;
  color: #203238;
  font-size: 30rpx;
  box-sizing: border-box;
}

.field-placeholder { color: #b4bdbe; }

.submit-btn {
  width: 100%;
  height: 100rpx;
  margin-top: 12rpx;
  border: none;
  border-radius: 30rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 100rpx;
}

.submit-btn::after { border: none; }

.alert {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #f0c7bc;
  border-radius: 24rpx;
  background: #fff5f1;
}

.alert-title { color: #9f3e2d; font-size: 27rpx; font-weight: 700; line-height: 1.4; }
.alert-detail { margin-top: 8rpx; color: #b25b49; font-size: 24rpx; line-height: 1.55; word-break: break-word; }
.alert-action { margin-top: 18rpx; color: #0f766e; font-size: 25rpx; font-weight: 700; }

.footer {
  margin-top: auto;
  padding: 48rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  color: #97a0a0;
  font-size: 23rpx;
  text-align: center;
}
