<view class="login-page">
  <view class="brand">
    <view class="brand-mark"><view class="seed-dot"></view>禾</view>
    <view class="brand-copy">
      <view class="brand-name">禾芽家庭教务</view>
      <view class="brand-sub">孩子的成长，值得被看见</view>
    </view>
  </view>

  <view class="login-hero">
    <view class="hero-line">成长记录、题库错题、作业报告</view>
    <view class="hero-title">把孩子的学习变化放进同一个家庭档案</view>
  </view>

  <view class="service-card {{serviceState}}">
    <view class="service-icon"><view class="service-dot"></view></view>
    <view class="service-main">
      <view class="service-title">{{serviceTitle}}</view>
      <view class="service-detail">{{serviceDetail}}</view>
    </view>
    <view wx:if="{{serviceState !== 'ok'}}" class="service-action" bindtap="retryService">重试</view>
  </view>

  <view class="login-sheet">
    <block wx:if="{{emailLoginStep}}">
      <view class="sheet-title">邮箱登录</view>
      <view class="sheet-subtitle">适用于早期用邮箱注册的账号</view>
      <view class="form-item">
        <view class="form-label">邮箱</view>
        <input class="input" type="text" placeholder="请输入邮箱" value="{{email}}" data-field="email" bindinput="onEmailField" />
      </view>
      <view class="form-item">
        <view class="form-label">密码</view>
        <input class="input" password placeholder="请输入密码" value="{{password}}" data-field="password" bindinput="onEmailField" />
      </view>
      <button class="btn btn-primary submit-button" loading="{{emailLoading}}" bindtap="submitEmailLogin">登录</button>
      <view class="email-back" bindtap="closeEmailLogin">返回微信登录</view>
      <view wx:if="{{error}}" class="error-card">
        <view class="error-title">{{error}}</view>
        <view wx:if="{{errorDetail}}" class="error-detail">{{errorDetail}}</view>
      </view>
    </block>

    <block wx:else>
    <view class="sheet-title">微信授权登录</view>
    <view class="sheet-subtitle">首次登录可选择创建新家庭，或申请加入已有家庭</view>

    <button class="wechat-btn" loading="{{wechatLoading}}" bindtap="wechatLogin">
      <view class="wechat-mark">微</view>
      <text>微信一键登录</text>
    </button>

    <view class="login-notice">登录后你会看到自己创建或已加入的家庭；家庭之间的数据完全隔离。</view>

    <view wx:if="{{error}}" class="error-card">
      <view class="error-title">{{error}}</view>
      <view wx:if="{{errorDetail}}" class="error-detail">{{errorDetail}}</view>
      <view class="error-actions">
        <view class="error-action primary" bindtap="wechatLogin">重试微信登录</view>
      </view>
    </view>

    <view class="email-entry" bindtap="openEmailLogin">邮箱登录</view>
    </block>
  </view>

  <view class="login-footer">家庭数据仅当前家庭的管理者可见</view>
</view>
