<view class="login-page">
  <view class="hero">
    <view class="hero-inner">
      <view class="mark">禾<view class="leaf"></view></view>
      <view class="brand">
        <view class="brand-name">禾芽家庭教务</view>
        <view class="brand-sub">我了解你，我来帮助你一起成长</view>
      </view>
    </view>
    <image class="login-child" src="/assets/illustrations/child-progress.png" mode="aspectFit" />
  </view>

  <view class="sheet">
    <block wx:if="{{emailLoginStep}}">
      <view class="sheet-title">邮箱登录</view>
      <view class="field">
        <view class="field-label">邮箱</view>
        <input class="field-input" type="text" placeholder="请输入邮箱" placeholder-class="field-placeholder"
               value="{{email}}" data-field="email" bindinput="onEmailField" />
      </view>
      <view class="field">
        <view class="field-label">密码</view>
        <input class="field-input" password placeholder="请输入密码" placeholder-class="field-placeholder"
               value="{{password}}" data-field="password" bindinput="onEmailField" />
      </view>
      <view class="agreement" bindtap="toggleAgreement"><view class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view><text>我已阅读并同意服务与隐私说明</text></view>
      <button class="submit-btn" loading="{{emailLoading}}" bindtap="submitEmailLogin">登录</button>
      <view class="link-center" bindtap="closeEmailLogin">返回微信登录</view>

      <view wx:if="{{error}}" class="alert">
        <view class="alert-title">{{error}}</view>
        <view wx:if="{{errorDetail}}" class="alert-detail">{{errorDetail}}</view>
      </view>
    </block>

    <block wx:else>
      <view class="welcome-title">欢迎回家</view>
      <view class="welcome-sub">登录后查看孩子的成长状态</view>
      <button class="wechat-btn" loading="{{wechatLoading}}" bindtap="wechatLogin">
        <view class="wechat-mark">微</view>
        <text>微信登录</text>
      </button>
      <view class="agreement" bindtap="toggleAgreement"><view class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</view><text>我已阅读并同意服务与隐私说明</text></view>

      <view wx:if="{{serviceState === 'unstable'}}" class="alert">
        <view class="alert-detail">{{serviceMessage}}</view>
        <view class="alert-action" bindtap="retryService">重试</view>
      </view>

      <view wx:if="{{error}}" class="alert">
        <view class="alert-title">{{error}}</view>
        <view wx:if="{{errorDetail}}" class="alert-detail">{{errorDetail}}</view>
        <view class="alert-action" bindtap="wechatLogin">重试微信登录</view>
      </view>

      <view class="divider"><text class="divider-text">其他方式</text></view>
      <view class="link-center" bindtap="openEmailLogin">邮箱登录</view>
    </block>
  </view>

  <view class="footer">家庭数据仅当前家庭的管理者可见</view>
</view>
