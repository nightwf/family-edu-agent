<view class="page"><view wx:if="{{error}}" class="error-tip">{{error}}</view><view wx:if="{{loading}}" class="loading-block">正在读取家庭信息...</view><block wx:else><view class="family-hero"><image src="/assets/illustrations/family-diorama.png" mode="aspectFit"/><view><view class="page-eyebrow">当前家庭</view><view class="family-title">{{family.name || '我的家庭'}}</view><view class="page-subtitle">{{members.length}} 位管理者共同维护孩子档案</view></view></view><view class="code-card"><view><view class="code-label">家庭编码</view><view class="code-value">{{joinCode || '未生成'}}</view><view class="code-help">其他家长用此编码提交加入申请</view></view><button class="copy-code" bindtap="copyCode">复制</button></view><view class="section-head"><view class="section-title">家庭管理者</view></view><view class="member-list"><view wx:for="{{members}}" wx:key="id" class="member-row"><view class="member-avatar">{{item.initial}}</view><view class="member-main"><view class="member-name">{{item.nameText}}</view><view class="member-meta">{{item.roleText}} · {{item.joinedText}}</view></view><view wx:if="{{item.canRemove}}" class="danger-link" data-id="{{item.id}}" bindtap="remove">移除</view><view wx:else class="pill">{{item.roleText}}</view></view></view><view wx:if="{{requests.length}}"><view class="section-head"><view class="section-title">待审核申请</view></view><view class="member-list"><view wx:for="{{requests}}" wx:key="id" class="member-row"><view class="member-main"><view class="member-name">{{item.nameText}}</view><view class="member-meta">{{item.dateText}} 提交</view></view><view class="request-actions"><view class="mini-btn reject" data-id="{{item.id}}" data-action="rejected" bindtap="review">拒绝</view><view class="mini-btn" data-id="{{item.id}}" data-action="approved" bindtap="review">通过</view></view></view></view></view><view class="section-head"><view class="section-title">我的家庭</view></view><view class="member-list"><view wx:for="{{memberships}}" wx:key="family.id" class="member-row"><view class="member-main"><view class="member-name">{{item.family.name}}</view><view class="member-meta">{{item.roleText}}</view></view><view wx:if="{{item.isCurrent}}" class="pill">当前</view><view wx:else class="switch-link" data-id="{{item.family.id}}" bindtap="switchFamily">切换</view></view></view><view class="join-card"><view class="section-title">申请加入其他家庭</view><view class="page-subtitle">输入家庭创建者提供的 6 位编码</view><input class="input" type="number" maxlength="6" value="{{joinCodeInput}}" bindinput="onJoinCodeInput" placeholder="6 位家庭编码"/><button class="btn btn-primary" loading="{{joinSubmitting}}" bindtap="submitJoin">提交申请</button></view></block></view>
