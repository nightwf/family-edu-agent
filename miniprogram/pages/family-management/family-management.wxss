.family-hero{display:flex;align-items:center;gap:20rpx;padding:20rpx 24rpx;border-radius:28rpx;background:linear-gradient(135deg,#e1f2ed,#fff4cf)}.family-hero image{width:190rpx;height:190rpx}.family-title{margin-top:4rpx;font-size:36rpx;font-weight:900}.code-card{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:20rpx;padding:24rpx;border:1rpx solid #ead8a7;border-radius:22rpx;background:#fff7d8}.code-label{color:#8b661b;font-size:22rpx;font-weight:800}.code-value{margin-top:4rpx;color:var(--ink);font-size:44rpx;font-weight:900;letter-spacing:4rpx}.code-help{margin-top:6rpx;color:var(--muted);font-size:21rpx}.copy-code{min-height:64rpx;margin:0;padding:0 22rpx;border-radius:999rpx;background:var(--teal);color:#fff;font-size:23rpx}.member-list{overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.member-row{display:flex;align-items:center;gap:16rpx;min-height:102rpx;padding:18rpx 20rpx;border-bottom:1rpx solid var(--line-soft)}.member-row:last-child{border-bottom:0}.member-avatar{width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:var(--teal-soft);color:var(--teal);font-weight:900}.member-main{min-width:0;flex:1}.member-name{font-size:27rpx;font-weight:800}.member-meta{margin-top:4rpx;color:var(--muted);font-size:22rpx}.danger-link{color:var(--accent);font-size:23rpx;font-weight:800}.switch-link{color:var(--teal);font-size:23rpx;font-weight:800}.request-actions{display:flex;gap:10rpx}.mini-btn{padding:10rpx 16rpx;border-radius:999rpx;background:var(--teal-soft);color:var(--teal);font-size:22rpx;font-weight:800}.mini-btn.reject{background:var(--accent-soft);color:var(--accent)}.join-card{margin-top:28rpx;padding:24rpx;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.join-card .input{margin-top:18rpx}.join-card .btn{margin-top:14rpx}
