.learning-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16rpx;margin-bottom:22rpx}.child-filter{max-width:310rpx;overflow:hidden;padding:12rpx 18rpx;border:1rpx solid #d8e7e2;border-radius:999rpx;background:#fff;color:var(--teal);font-size:22rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.diagnosis-card{position:relative;overflow:hidden;padding:30rpx;border-radius:30rpx;background:linear-gradient(135deg,#176f69,#205159);color:#fff;box-shadow:0 20rpx 46rpx rgba(18,91,85,.2)}.diagnosis-copy{position:relative;z-index:2;width:62%;min-height:240rpx}.diagnosis-kicker{color:#cde6e1;font-size:21rpx;font-weight:800}.diagnosis-title{margin-top:8rpx;font-size:37rpx;font-weight:900;line-height:1.25}.diagnosis-sub{margin-top:12rpx;color:#d7eae7;font-size:24rpx;line-height:1.55}.diagnosis-card image{position:absolute;right:-12rpx;top:0;width:270rpx;height:300rpx}.diagnosis-stats{position:relative;z-index:2;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:18rpx;padding:14rpx;border-radius:18rpx;background:rgba(255,255,255,.12);font-size:20rpx;text-align:center}.diagnosis-stats text{display:block;color:var(--gold);font-size:30rpx;font-weight:900}.focus-list{overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--panel)}.focus-row{display:flex;align-items:center;gap:16rpx;padding:20rpx 22rpx;border-bottom:1rpx solid var(--line-soft)}.focus-row:last-child{border-bottom:0}.focus-main{min-width:0;flex:1}.focus-name{font-size:27rpx;font-weight:800}.focus-meta{margin:3rpx 0 9rpx;color:var(--muted);font-size:21rpx}.focus-score{width:68rpx;color:var(--teal);font-size:34rpx;font-weight:900;text-align:right}.module-grid{display:grid;gap:14rpx}.module-card{display:flex;align-items:center;gap:16rpx;min-height:100rpx;padding:18rpx 20rpx;border:1rpx solid var(--line);border-radius:20rpx;background:var(--panel)}.module-card.primary{border-color:#ecc7ba;background:#fff4ef}.module-icon{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:var(--accent-soft);color:var(--accent);font-weight:900}.module-icon.teal{background:var(--teal-soft);color:var(--teal)}.module-icon.gold{background:var(--gold-soft);color:#84621b}.module-card>view:nth-child(2){min-width:0;flex:1}.module-name{font-size:27rpx;font-weight:800}.module-desc{margin-top:3rpx;color:var(--muted);font-size:21rpx}.module-card>text{color:var(--muted);font-size:36rpx}.slim-empty{min-height:150rpx}
