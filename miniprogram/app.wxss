page {
  --bg: #f6f0dc;
  --panel: #fffaf0;
  --ink: #26343b;
  --muted: #7a8a90;
  --teal: #0f766e;
  --teal-soft: #e4f3ef;
  --gold: #f3c969;
  --accent: #c9503a;
  --line: #e8ddc5;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.panel {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 22rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}

.muted {
  color: var(--muted);
}

.title {
  font-size: 38rpx;
  font-weight: 700;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 30rpx 0 18rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-primary {
  background: var(--teal);
  color: #ffffff;
}

.btn-outline {
  background: #ffffff;
  border: 1rpx solid var(--line);
  color: var(--ink);
}

.btn-danger {
  background: #fff6f3;
  border: 1rpx solid #f1c4b8;
  color: var(--accent);
}

.btn-disabled {
  opacity: 0.5;
}

.input {
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: var(--teal-soft);
  color: var(--teal);
}

.pill-warn {
  background: #fff1df;
  color: #9a5b13;
}

.pill-danger {
  background: #ffeae4;
  color: var(--accent);
}

.empty {
  padding: 80rpx 30rpx;
  text-align: center;
  color: var(--muted);
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(23, 37, 42, 0.55);
  display: flex;
  align-items: flex-end;
}

.modal {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--panel);
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 26rpx 40rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: 44rpx;
}

.form-item {
  margin-bottom: 22rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}

.tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  margin-bottom: 20rpx;
  padding-bottom: 4rpx;
}

.tab {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 26rpx;
}

.tab.active {
  background: var(--teal);
  border-color: var(--teal);
  color: #ffffff;
}

.list-divider {
  border-bottom: 1rpx dashed var(--line);
  margin: 18rpx 0;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-card {
  border-top: 6rpx solid var(--gold);
  background: var(--panel);
  border-radius: 14rpx;
  padding: 20rpx;
}

.stat-card.teal {
  border-top-color: var(--teal);
}

.stat-card.accent {
  border-top-color: var(--accent);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.progress {
  height: 14rpx;
  background: #ece2cf;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--teal);
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: #f1e9d8;
  color: #6d5a35;
  font-size: 22rpx;
}

.tag-teal {
  background: var(--teal-soft);
  color: var(--teal);
}

.icon-btn {
  padding: 10rpx 18rpx;
  color: var(--teal);
  font-size: 26rpx;
}

.danger-btn {
  padding: 10rpx 18rpx;
  color: var(--accent);
  font-size: 26rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 22rpx 0;
}
