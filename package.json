{
  "name": "family-edu-agent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "家庭 AI 教育 Agent 生产架构：PostgreSQL + Fastify + React + MCP",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @family-edu/api",
    "build": "npm run build --workspace @family-edu/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace @family-edu/api",
    "test:e2e": "npx playwright test --config apps/web/playwright.config.js",
    "test:mcp": "bash scripts/mcp-smoke.sh",
    "check:miniprogram": "node scripts/validate-miniprogram.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "typescript": "^5.8.0"
  }
}
