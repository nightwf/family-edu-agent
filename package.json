{
  "name": "family-edu-agent",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "家庭 AI 教育 Agent 生产架构：PostgreSQL + Fastify + React + MCP",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @family-edu/api",
    "build": "npm run build --workspace @family-edu/web",
    "test": "npm run test --workspaces --if-present && npm run test:voice && npm run test:miniprogram && npm run check:miniprogram && npm run test:ops",
    "test:api": "npm run test --workspace @family-edu/api",
    "test:voice": "tsx scripts/test-tutor-voice.ts",
    "test:e2e": "npx playwright test --config apps/web/playwright.config.js",
    "test:mcp": "bash scripts/mcp-smoke.sh",
    "smoke:learning": "node scripts/mcp-learning-engine-smoke.mjs",
    "check:workbuddy": "node scripts/validate-workbuddy-open-platform.mjs",
    "package:workbuddy": "node scripts/package-workbuddy-open-platform.mjs",
    "check:miniprogram": "node scripts/validate-miniprogram.mjs",
    "check:miniprogram-assets": "node scripts/validate-miniprogram-assets.mjs",
    "check:miniprogram-assets:selftest": "node scripts/validate-miniprogram-assets.mjs --self-test",
    "test:miniprogram": "node scripts/test-miniprogram-logic.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate-legacy": "node scripts/migrate-v2.mjs",
    "smoke:plan-enum": "node scripts/mcp-plan-enum-smoke.mjs",
    "android:apk": "bash scripts/build-android-apk.sh",
    "android:icons": "node scripts/render-android-icons.mjs",
    "verify:web-responsive": "node scripts/verify-web-responsive.mjs",
    "check:doubao": "node scripts/check-doubao-models.mjs",
    "test:ops": "node scripts/test-upsert-env.mjs && node scripts/test-sse-parse.mjs"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "typescript": "^5.8.0"
  }
}
