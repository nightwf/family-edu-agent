generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id                  String                       @id @default(cuid())
  name                String
  inviteCode          String
  educationPhilosophy String?
  communicationStyle  String?
  strictness          String?
  parentGoals         String[]
  status              String                       @default("active")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  users               User[]
  members             FamilyMember[]
  invites             FamilyInvite[]
  mcpTokens           McpToken[]
  children            Child[]
  records             Record[]
  reports             Report[]
  textbooks           Textbook[]
  homework            Homework[]
  knowledge           KnowledgeItem[]
  questionTypes       QuestionType[]
  questions           Question[]
  questionAttempts    QuestionAttempt[]
  questionMasteries   StudentQuestionTypeMastery[]
  wrongQuestions      WrongQuestionEntry[]
  practicePapers      PracticePaper[]
  remediationPlans    RemediationPlan[]
}

model User {
  id                String    @id @default(cuid())
  familyId          String
  family            Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email             String    @unique
  passwordHash      String
  role              String    @default("parent")
  status            String    @default("active")
  wechatOpenId      String?   @unique
  wechatUnionId     String?
  wechatNickname    String?
  wechatAvatarUrl   String?
  lastWechatLoginAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sessions          Session[]
  familyMembers     FamilyMember[]
  mcpTokens         McpToken[]
  sentInvites       FamilyInvite[] @relation("FamilyInviteInviter")
  acceptedInvites   FamilyInvite[] @relation("FamilyInviteAcceptor")
}

model FamilyMember {
  id        String    @id @default(cuid())
  familyId  String
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String    @default("admin")
  status    String    @default("active")
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  mcpTokens McpToken[]

  @@unique([familyId, userId])
  @@index([userId, status])
  @@index([familyId, role, status])
}

model FamilyInvite {
  id               String    @id @default(cuid())
  familyId         String
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedByUserId  String
  invitedBy        User      @relation("FamilyInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  inviteCode       String    @unique
  inviteEmail      String?
  role             String    @default("admin")
  status           String    @default("pending")
  expiresAt        DateTime
  acceptedByUserId String?
  acceptedBy       User?     @relation("FamilyInviteAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([familyId, status])
  @@index([inviteCode, status])
}

model Child {
  id                String                       @id @default(cuid())
  familyId          String
  family            Family                       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name              String
  age               Int?
  grade             String
  subjects          String[]
  textbookVersion   String?
  status            String                       @default("active")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  records           Record[]
  reports           Report[]
  textbooks         Textbook[]
  homework          Homework[]
  knowledge         KnowledgeItem[]
  questionAttempts  QuestionAttempt[]
  questionMasteries StudentQuestionTypeMastery[]
  wrongQuestions    WrongQuestionEntry[]
  practicePapers    PracticePaper[]
  remediationPlans  RemediationPlan[]
}

model Record {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  type      String
  date      DateTime
  title     String
  content   String?
  score     Int?
  notes     String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(cuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  type        String
  periodStart DateTime
  periodEnd   DateTime
  title       String
  summary     String?
  metrics     Json?
  content     String?
  createdAt   DateTime @default(now())
}

model Textbook {
  id              String   @id @default(cuid())
  familyId        String
  family          Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId         String
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  title           String
  subject         String?
  grade           String?
  publisher       String?
  version         String?
  source          String   @default("workbuddy")
  fileKey         String?
  chapters        Json?
  knowledgePoints String[]
  status          String   @default("ready")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Homework {
  id               String    @id @default(cuid())
  familyId         String
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId          String
  child            Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  subject          String?
  title            String
  description      String?
  estimatedMinutes Int?
  priority         String    @default("medium")
  dueDate          DateTime?
  status           String    @default("pending")
  difficulty       String?
  source           String    @default("workbuddy")
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  content   String
  source    String   @default("workbuddy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
}

model SkillVersion {
  id        String   @id @default(cuid())
  skillId   String
  version   String
  title     String?
  content   String
  status    String   @default("draft")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skillId, version])
}

model FamilySkillProfile {
  id                 String          @id @default(cuid())
  familyId           String
  skillId            String
  baseVersion        String          @default("1.0.0")
  active             Boolean         @default(true)
  philosophy         String?
  communicationStyle String?
  strictness         String?
  parentGoals        String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  overrides          SkillOverride[]

  @@unique([familyId, skillId])
}

model SkillOverride {
  id            String             @id @default(cuid())
  profileId     String
  profile       FamilySkillProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  path          String
  originalValue String?
  customValue   String
  reason        String?
  createdBy     String?
  approvedBy    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model PolicyChange {
  id         String    @id @default(cuid())
  familyId   String
  skillId    String?
  type       String
  summary    String?
  before     Json?
  after      Json?
  reason     String?
  createdBy  String?
  status     String    @default("proposed")
  effective  Boolean?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

model McpToken {
  id             String        @id @default(cuid())
  familyId       String
  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  tokenHash      String        @unique
  tokenCipher    String?
  name           String?
  status         String        @default("active")
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())
  revokedAt      DateTime?

  @@index([familyId, userId, status])
  @@index([familyMemberId])
}

model QuestionType {
  id                 String                       @id @default(cuid())
  familyId           String
  family             Family                       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  subject            String
  grade              String?
  name               String
  description        String?
  textbook           String?
  chapter            String?
  knowledgePoints    String[]                     @default([])
  tags               String[]                     @default([])
  abilityGoal        String?
  solutionMethod     String?
  standardSteps      Json?
  commonErrors       Json?
  invariants         Json?
  variableParameters Json?
  difficultyLevels   Json?
  generationRule     Json?
  answerValidation   Json?
  masteryCriteria    Json?
  ruleVersion        String                       @default("1.0.0")
  status             String                       @default("active")
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  questions          Question[]
  attempts           QuestionAttempt[]
  masteries          StudentQuestionTypeMastery[]
  wrongQuestions     WrongQuestionEntry[]
  remediationTasks   RemediationTask[]

  @@index([familyId, subject, grade])
  @@index([familyId, status])
}

model Question {
  id                    String                  @id @default(cuid())
  familyId              String
  family                Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  questionTypeId        String
  questionType          QuestionType            @relation(fields: [questionTypeId], references: [id], onDelete: Restrict)
  stem                  String
  format                String                  @default("short_answer")
  options               Json?
  answer                Json?
  solution              String?
  scoringRubric         Json?
  difficulty            String                  @default("basic")
  tags                  String[]                @default([])
  source                String                  @default("workbuddy")
  originalContent       String?
  fileKey               String?
  sourceQuestionId      String?
  generationRuleVersion String?
  variationType         String?
  generatedByWorkbuddy  Boolean                 @default(false)
  status                String                  @default("active")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  attempts              QuestionAttempt[]
  wrongQuestions        WrongQuestionEntry[]
  practicePaperItems    PracticePaperQuestion[]

  @@index([familyId, questionTypeId, status])
  @@index([familyId, difficulty])
  @@index([sourceQuestionId])
}

model QuestionAttempt {
  id                     String              @id @default(cuid())
  familyId               String
  family                 Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId                String
  child                  Child               @relation(fields: [childId], references: [id], onDelete: Cascade)
  questionId             String
  question               Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionTypeId         String
  questionType           QuestionType        @relation(fields: [questionTypeId], references: [id], onDelete: Cascade)
  studentAnswer          Json?
  isCorrect              Boolean?
  score                  Float?
  durationSeconds        Int?
  usedHint               Boolean             @default(false)
  hintCount              Int                 @default(0)
  errorReason            String?
  evaluation             String?
  wrongQuestionId        String?
  wrongQuestion          WrongQuestionEntry? @relation("WrongQuestionAttempts", fields: [wrongQuestionId], references: [id], onDelete: SetNull)
  latestForWrongQuestion WrongQuestionEntry? @relation("LatestWrongSourceAttempt")
  practicePaperId        String?
  practicePaper          PracticePaper?      @relation(fields: [practicePaperId], references: [id], onDelete: SetNull)
  isOriginalCorrection   Boolean             @default(false)
  isIndependent          Boolean?
  variationType          String?
  sessionId              String?
  attemptedAt            DateTime            @default(now())
  createdAt              DateTime            @default(now())

  @@index([familyId, childId, attemptedAt])
  @@index([childId, questionTypeId, attemptedAt])
  @@index([questionId])
  @@index([wrongQuestionId, attemptedAt])
  @@index([practicePaperId])
}

model StudentQuestionTypeMastery {
  id                  String       @id @default(cuid())
  familyId            String
  family              Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId             String
  child               Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  questionTypeId      String
  questionType        QuestionType @relation(fields: [questionTypeId], references: [id], onDelete: Cascade)
  status              String       @default("unassessed")
  calculatedStatus    String       @default("unassessed")
  masteryScore        Float        @default(0)
  totalAttempts       Int          @default(0)
  correctAttempts     Int          @default(0)
  correctRate         Float        @default(0)
  correctStreak       Int          @default(0)
  independentAttempts Int          @default(0)
  variationCount      Int          @default(0)
  transferScore       Float?
  lastPracticedAt     DateTime?
  lastAssessedAt      DateTime?
  nextReviewAt        DateTime?
  evidence            Json?
  manualStatus        String?
  manualReason        String?
  manualSource        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([childId, questionTypeId])
  @@index([familyId, childId, status])
  @@index([familyId, questionTypeId])
}

model WrongQuestionEntry {
  id                    String                  @id @default(cuid())
  familyId              String
  family                Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId               String
  child                 Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  questionId            String
  question              Question                @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionTypeId        String
  questionType          QuestionType            @relation(fields: [questionTypeId], references: [id], onDelete: Restrict)
  subject               String
  grade                 String?
  textbook              String?
  chapter               String?
  knowledgePoints       String[]                @default([])
  latestSourceAttemptId String?                 @unique
  latestSourceAttempt   QuestionAttempt?        @relation("LatestWrongSourceAttempt", fields: [latestSourceAttemptId], references: [id], onDelete: SetNull)
  latestWrongAnswer     Json?
  errorReason           String?
  errorCategory         String?
  workbuddyAnalysis     String?
  correctionMethod      String?
  keyLearningPoint      String?
  firstWrongAt          DateTime                @default(now())
  lastWrongAt           DateTime                @default(now())
  mistakeCount          Int                     @default(1)
  status                String                  @default("pending_correction")
  calculatedStatus      String                  @default("pending_correction")
  masteryScore          Float                   @default(0)
  masteryEvidence       Json?
  nextReviewAt          DateTime?
  masteredAt            DateTime?
  manualStatus          String?
  manualReason          String?
  manualSource          String?
  source                String                  @default("workbuddy")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  attempts              QuestionAttempt[]       @relation("WrongQuestionAttempts")
  practicePaperItems    PracticePaperQuestion[]
  remediationTasks      RemediationTask[]

  @@unique([childId, questionId])
  @@index([familyId, childId, status])
  @@index([familyId, subject, lastWrongAt])
  @@index([questionTypeId])
}

model PracticePaper {
  id                     String                  @id @default(cuid())
  familyId               String
  family                 Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId                String
  child                  Child                   @relation(fields: [childId], references: [id], onDelete: Cascade)
  title                  String
  subject                String?
  grade                  String?
  objective              String?
  diagnosisSummary       String?
  difficultyDistribution Json?
  estimatedMinutes       Int?
  totalScore             Float?
  status                 String                  @default("draft")
  source                 String                  @default("workbuddy")
  generatedAt            DateTime                @default(now())
  completedAt            DateTime?
  resultSummary          Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  questions              PracticePaperQuestion[]
  attempts               QuestionAttempt[]

  @@index([familyId, childId, status])
  @@index([familyId, subject, generatedAt])
}

model PracticePaperQuestion {
  id                  String              @id @default(cuid())
  practicePaperId     String
  practicePaper       PracticePaper       @relation(fields: [practicePaperId], references: [id], onDelete: Cascade)
  questionId          String
  question            Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  wrongQuestionId     String?
  wrongQuestion       WrongQuestionEntry? @relation(fields: [wrongQuestionId], references: [id], onDelete: SetNull)
  section             String?
  sequence            Int
  score               Float?
  purpose             String?
  targetErrorCategory String?
  createdAt           DateTime            @default(now())

  @@unique([practicePaperId, sequence])
  @@index([questionId])
  @@index([wrongQuestionId])
}

model RemediationPlan {
  id         String            @id @default(cuid())
  familyId   String
  family     Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId    String
  child      Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  title      String
  subject    String?
  diagnosis  Json?
  objectives Json?
  strategy   String?
  startDate  DateTime?
  endDate    DateTime?
  status     String            @default("active")
  source     String            @default("workbuddy")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tasks      RemediationTask[]

  @@index([familyId, childId, status])
  @@index([familyId, subject, startDate])
}

model RemediationTask {
  id                 String              @id @default(cuid())
  planId             String
  plan               RemediationPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  wrongQuestionId    String?
  wrongQuestion      WrongQuestionEntry? @relation(fields: [wrongQuestionId], references: [id], onDelete: SetNull)
  questionTypeId     String?
  questionType       QuestionType?       @relation(fields: [questionTypeId], references: [id], onDelete: Restrict)
  title              String
  description        String?
  taskType           String
  sequence           Int
  estimatedMinutes   Int?
  dueAt              DateTime?
  status             String              @default("pending")
  completionEvidence Json?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([planId, sequence])
  @@index([wrongQuestionId])
  @@index([questionTypeId])
  @@index([status, dueAt])
}

enum FamilyRole {
  OWNER
  ADMIN
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum ChildStatus {
  ACTIVE
  ARCHIVED
}

enum ResourceStatus {
  ACTIVE
  ARCHIVED
  SUPERSEDED
  DRAFT
}

enum GoalStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum WeeklyPlanStatus {
  DRAFT
  PROPOSED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlanItemType {
  SCHOOL_HOMEWORK
  CHILD_TASK
  PARENT_ACTION
  AGENT_TASK
  RETEST
}

enum PlanItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
  NEEDS_REVIEW
}

enum EvidenceType {
  OBSERVATION
  WRITING
  READING
  HOMEWORK_COMPLETION
  QUESTION_ATTEMPT
  RETEST
  PARENT_NOTE
}

enum ReviewStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CORRECTED
  SUPERSEDED
}

enum MethodCategory {
  CORE
  SCENARIO
  PHILOSOPHY
}

enum KnowledgeNodeType {
  CHAPTER
  KNOWLEDGE_POINT
  CONCEPT
  EXAMPLE
  MISCONCEPTION
}

enum KnowledgeRelationType {
  PREREQUISITE_OF
  CONTAINS
  RELATED_TO
  EXAMPLE_OF
  ERROR_OF
}

enum ChildKnowledgeStatus {
  UNASSESSED
  LEARNING
  PARTIAL
  MASTERED
  NEEDS_REVIEW
}

model FamilyPolicy {
  id               String    @id @default(cuid())
  familyId         String    @unique
  weeklyTimeBudget Int?
  prioritySubjects String[]  @default([])
  pressureBoundary String?
  parentGoals      String[]  @default([])
  principles       Json?
  version          Int       @default(1)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model EducationMethod {
  id            String         @id @default(cuid())
  key           String         @unique
  name          String
  category      MethodCategory
  evidenceLevel String
  description   String
  applicability Json?
  risks         Json?
  workflow      Json?
  version       String
  status        ResourceStatus @default(ACTIVE)
  validFrom     DateTime       @default(now())
  validUntil    DateTime?
  supersededBy  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  effects       MethodEffect[]
}

model MethodEffect {
  id          String         @id @default(cuid())
  familyId    String
  childId     String
  methodId    String
  method      EducationMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        StageGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  context     Json?
  outcome     String
  confidence  Float?
  evidenceRef String?
  observedAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([familyId, childId, methodId])
  @@index([goalId])
}

model EvidenceRecord {
  id                String       @id @default(cuid())
  familyId          String
  childId           String
  type              EvidenceType
  taskDescription   String?
  environment       String?
  observedBehavior  String?
  frequency         String?
  effectiveStrategy String?
  counterEvidence   String?
  confidence        Float?
  source            String       @default("workbuddy")
  sourceRef         String?
  observedAt        DateTime     @default(now())
  reviewStatus      ReviewStatus @default(PENDING_CONFIRMATION)
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNote        String?
  createdAt         DateTime     @default(now())

  @@index([familyId, childId, observedAt])
  @@index([familyId, childId, type, reviewStatus])
}

model ChildStateSnapshot {
  id            String   @id @default(cuid())
  familyId      String
  childId       String
  asOf          DateTime
  periodWindow  String
  summary       Json?
  indicators    Json?
  confidence    Float?
  sourceVersion String?
  generatedAt   DateTime @default(now())

  @@unique([childId, periodWindow, asOf])
  @@index([familyId, childId, generatedAt])
}

model StageGoal {
  id             String         @id @default(cuid())
  familyId       String
  childId        String
  title          String
  objective      String
  criteria       Json?
  startDate      DateTime
  endDate        DateTime
  status         GoalStatus     @default(DRAFT)
  proposedBy     String?
  confirmedBy    String?
  confirmedAt    DateTime?
  methodIds      String[]       @default([])
  contextVersion String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  plans          WeeklyPlan[]
  assessments    Assessment[]
  methodEffects  MethodEffect[]

  @@index([familyId, childId, status])
  @@index([familyId, childId, startDate, endDate])
}

model WeeklyPlan {
  id             String           @id @default(cuid())
  familyId       String
  childId        String
  stageGoalId    String
  stageGoal      StageGoal        @relation(fields: [stageGoalId], references: [id], onDelete: Cascade)
  weekStart      DateTime
  weekEnd        DateTime
  status         WeeklyPlanStatus @default(DRAFT)
  generatedBy    String?
  confirmedBy    String?
  confirmedAt    DateTime?
  contextVersion String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          PlanItem[]

  @@index([familyId, childId, weekStart])
  @@unique([stageGoalId, weekStart])
}

model PlanItem {
  id                 String         @id @default(cuid())
  weeklyPlanId       String
  weeklyPlan         WeeklyPlan     @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  type               PlanItemType
  title              String
  description        String?
  ownerUserId        String?
  methodId           String?
  sourceRef          String?
  sequence           Int
  estimatedMinutes   Int?
  dueAt              DateTime?
  status             PlanItemStatus @default(PENDING)
  completionEvidence Json?
  completedAt        DateTime?
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([weeklyPlanId, sequence])
  @@index([weeklyPlanId, status, dueAt])
}

model PlanChange {
  id         String    @id @default(cuid())
  familyId   String
  planId     String?
  planItemId String?
  type       String
  before     Json?
  after      Json?
  reason     String?
  createdBy  String
  approvedBy String?
  status     String    @default("proposed")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([familyId, status])
}

model Assessment {
  id             String     @id @default(cuid())
  familyId       String
  childId        String
  stageGoalId    String?
  stageGoal      StageGoal? @relation(fields: [stageGoalId], references: [id], onDelete: SetNull)
  planItemId     String?
  title          String
  assessmentType String
  criteria       Json?
  score          Float?
  passed         Boolean?
  outcome        Json?
  sourceRef      String?
  observedAt     DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@index([familyId, childId, observedAt])
  @@index([stageGoalId])
}

model SourceDocument {
  id           String         @id @default(cuid())
  familyId     String
  title        String
  kind         String
  subject      String?
  grade        String?
  publisher    String?
  version      String?
  fileKey      String?
  status       ResourceStatus @default(ACTIVE)
  validFrom    DateTime       @default(now())
  validUntil   DateTime?
  supersededBy String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  nodes        KnowledgeNode[]

  @@index([familyId, subject, grade, status])
}

model KnowledgeNode {
  id                  String                @id @default(cuid())
  familyId            String
  sourceDocumentId    String?
  sourceDocument      SourceDocument?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  parentId            String?
  parent              KnowledgeNode?        @relation("KnowledgeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children            KnowledgeNode[]       @relation("KnowledgeTree")
  type                KnowledgeNodeType
  subject             String?
  grade               String?
  title               String
  description         String?
  content             Json?
  sourcePage          String?
  version             String
  status              ResourceStatus       @default(ACTIVE)
  validFrom           DateTime             @default(now())
  validUntil          DateTime?
  supersededBy        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  outgoingRelations   KnowledgeRelation[]   @relation("RelationSource")
  incomingRelations   KnowledgeRelation[]   @relation("RelationTarget")
  childStates         ChildKnowledgeState[]

  @@index([familyId, subject, grade, status])
  @@index([familyId, sourceDocumentId])
}

model KnowledgeRelation {
  id           String                @id @default(cuid())
  familyId     String
  sourceNodeId String
  sourceNode   KnowledgeNode         @relation("RelationSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId String
  targetNode   KnowledgeNode         @relation("RelationTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  relationType KnowledgeRelationType
  metadata     Json?
  version      String
  validFrom    DateTime              @default(now())
  validUntil   DateTime?
  createdAt    DateTime              @default(now())

  @@index([familyId, sourceNodeId, relationType])
  @@index([familyId, targetNodeId, relationType])
}

model ChildKnowledgeState {
  id              String               @id @default(cuid())
  familyId        String
  childId         String
  knowledgeNodeId String
  knowledgeNode   KnowledgeNode        @relation(fields: [knowledgeNodeId], references: [id], onDelete: Cascade)
  status          ChildKnowledgeStatus @default(UNASSESSED)
  score           Float                @default(0)
  evidence        Json?
  lastPracticedAt DateTime?
  nextReviewAt    DateTime?
  manualStatus    String?
  manualReason    String?
  manualSource    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([childId, knowledgeNodeId])
  @@index([familyId, childId, status])
  @@index([knowledgeNodeId, status])
}

model WeeklyReview {
  id                String    @id @default(cuid())
  familyId          String
  childId           String
  weekStart         DateTime
  weekEnd           DateTime
  status            String    @default("draft")
  draft             Json?
  parentAdjustments Json?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([childId, weekStart])
  @@index([familyId, childId, status])
}

model StageReport {
  id                  String    @id @default(cuid())
  familyId            String
  childId             String
  stageGoalId         String?
  periodStart         DateTime
  periodEnd           DateTime
  verdict             String?
  summary             String?
  evidence            Json?
  nextRecommendations Json?
  status              String    @default("draft")
  generatedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@index([familyId, childId, generatedAt])
  @@index([stageGoalId])
}

model StoredObject {
  id              String    @id @default(cuid())
  familyId        String
  bucket          String
  objectKey       String
  contentType     String?
  size            Int?
  checksum        String?
  retentionPolicy String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([familyId, status])
}

model BackgroundJob {
  id        String    @id @default(cuid())
  familyId  String?
  type      String
  status    String    @default("pending")
  payload   Json?
  nextRunAt DateTime?
  lockedAt  DateTime?
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, status, nextRunAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  familyId   String?
  actorType  String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([familyId, createdAt])
  @@index([entityType, entityId])
}
